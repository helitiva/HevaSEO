{
  "name": "hevaseo-platform",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @heva/web dev",
    "build": "pnpm --filter @heva/web build",
    "preview": "pnpm --filter @heva/web preview",
    "doc-coverage": "node scripts/crawl/manifest.mjs && node scripts/crawl/doc-coverage.mjs",
    "doc-coverage:ci": "node scripts/crawl/manifest.mjs && node scripts/crawl/doc-coverage.mjs --ci",
    "doc-coverage:accept": "node scripts/crawl/manifest.mjs && node scripts/crawl/doc-coverage.mjs --update-baseline"
  }
}
