---
import Logo from './Logo.astro';
import { site, footerLinks } from '../data/site';
---
<footer class="border-t border-border bg-card">
  <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <Logo href="/#top" />
        <p class="mt-4 max-w-xs text-sm text-muted-foreground">{site.tagline}</p>
      </div>
      <div>
        <h4 class="text-sm font-bold">Services</h4>
        <ul class="mt-4 space-y-2.5 text-sm text-muted-foreground">
          {footerLinks.services.map((l) => (
            <li><a href={l.href} class="transition hover:text-primary">{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-bold">Company</h4>
        <ul class="mt-4 space-y-2.5 text-sm text-muted-foreground">
          {footerLinks.company.map((l) => (
            <li><a href={l.href} class="transition hover:text-primary">{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-bold">Contact</h4>
        <ul class="mt-4 space-y-2.5 text-sm text-muted-foreground">
          <li class="flex items-center gap-2"><i class="ph-bold ph-envelope-simple"></i> {site.email}</li>
          <li class="flex items-center gap-2"><i class="ph-bold ph-phone"></i> {site.phone}</li>
          <li class="flex items-center gap-2"><i class="ph-bold ph-map-pin"></i> {site.address}</li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <p>© 2026 HevaSEO. All rights reserved.</p>
        <a href="/privacy" class="transition hover:text-primary">Privacy</a>
        <a href="/terms" class="transition hover:text-primary">Terms</a>
      </div>
      <div class="flex gap-4">
        <a href={site.social.facebook} aria-label="Facebook" class="transition hover:text-primary"><i class="ph-bold ph-facebook-logo text-lg"></i></a>
        <a href={site.social.youtube} aria-label="YouTube" class="transition hover:text-primary"><i class="ph-bold ph-youtube-logo text-lg"></i></a>
        <a href={site.social.linkedin} aria-label="LinkedIn" class="transition hover:text-primary"><i class="ph-bold ph-linkedin-logo text-lg"></i></a>
      </div>
    </div>
  </div>
</footer>
