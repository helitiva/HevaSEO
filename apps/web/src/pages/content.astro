---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingGrid from '../components/PricingGrid.astro';

const SCORE_BADGE = 'Content Score & Methodology';

const aiTiers = [
  { name: 'A1000', subtitle: '~1000 words · standard', icon: 'ph-file-text', hue: 'sky', price: '$12', strike: '$30', delivery: '2–3 days', footerBadge: SCORE_BADGE, cta: 'Choose A1000', goi: 'A1000 · $12', features: ['1 SEO article (~1,000 words) + illustrative images', 'On-page: title / meta / headings / density / internal links', 'Plagiarism &amp; AI-detection checked', 'Google-safe, helpful content', 'HTML preview · DOC · TXT · images'] },
  { name: 'A2000', subtitle: '~2000 words · in-depth', icon: 'ph-files', hue: 'violet', price: '$19', strike: '$47', delivery: '~3 days', popular: true, footerBadge: SCORE_BADGE, cta: 'Choose A2000', goi: 'A2000 · $19', features: ['<b class="font-semibold text-foreground">In-depth 2,000-word article</b> + images', 'Full on-page optimization (title/meta/headings/density)', 'Internal links + outbound citations', 'Plagiarism &amp; AI-detection checked', 'HTML preview · DOC · TXT · images'] },
  { name: 'A3000', subtitle: '~3000 words · pillar', icon: 'ph-newspaper-clipping', hue: 'amber', price: '$28', strike: '$70', delivery: '3–4 days', footerBadge: SCORE_BADGE, cta: 'Choose A3000', goi: 'A3000 · $28', features: ['<b class="font-semibold text-foreground">Pillar-length 3,000-word article</b> + images', 'Full on-page optimization', 'Topic-cluster ready + internal linking', 'Plagiarism &amp; AI-detection checked', 'HTML preview · DOC · TXT · images'] },
];

const humanTiers = [
  { name: 'H1000', subtitle: '~1000 words · human', icon: 'ph-file-text', hue: 'sky', price: '$24', strike: '$60', delivery: '3–4 days', footerBadge: SCORE_BADGE, cta: 'Choose H1000', goi: 'H1000 · $24', features: ['Human-written SEO article (~1,000 words) + images', '<b class="font-semibold text-foreground">E-E-A-T</b> — real expertise &amp; cited sources', 'On-page: title / meta / headings / density', 'Plagiarism &amp; AI-detection checked', 'HTML preview · DOC · TXT · images'] },
  { name: 'H2000', subtitle: '~2000 words · in-depth', icon: 'ph-files', hue: 'violet', price: '$39', strike: '$97', delivery: '~4 days', popular: true, footerBadge: SCORE_BADGE, cta: 'Choose H2000', goi: 'H2000 · $39', features: ['<b class="font-semibold text-foreground">In-depth 2,000-word</b> human-written article + images', 'Deep E-E-A-T, expert sourcing &amp; references', 'Full on-page optimization + internal links', 'Plagiarism &amp; AI-detection checked', 'HTML preview · DOC · TXT · images'] },
  { name: 'H3000', subtitle: '~3000 words · pillar', icon: 'ph-newspaper-clipping', hue: 'amber', price: '$56', strike: '$140', delivery: '~5 days', footerBadge: SCORE_BADGE, cta: 'Choose H3000', goi: 'H3000 · $56', features: ['<b class="font-semibold text-foreground">Pillar-length 3,000-word</b> human-written article + images', 'Deepest E-E-A-T &amp; topical authority', 'Full on-page + internal linking', 'Plagiarism &amp; AI-detection checked', 'HTML preview · DOC · TXT · images'] },
];
---
<BaseLayout
  title="SEO Content Writing — Scored, Sourced & Google-Safe | HevaSEO"
  description="SEO content that ranks and stays safe — AI-powered or human-written with E-E-A-T. Every article ships with a Content Score & Methodology report (voice, sources, intent, keywords, readability, E-E-A-T, originality) plus HTML, DOC, TXT and images. Plans from $12."
  keywords="seo content writing, ai content writing, human written seo content, e-e-a-t content, content score, seo article writing service, geo content"
  ogDescription="Google-safe SEO articles — AI-powered or human-written — every one delivered with a transparent Content Score & Methodology report. From $12."
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "SEO Content Writing",
        "serviceType": "AI-powered & human-written SEO content with a transparent quality score",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "SEO content writing in two tiers — AI-powered (AI ~70% / editor) and human-written with E-E-A-T. Every article is Google-guideline compliant, checked for plagiarism and AI-detection, and delivered with a Content Score & Methodology report plus HTML, DOC, TXT and images.",
        "offers": [
          { "@type": "Offer", "name": "A1000 (AI ~1000 words)", "price": "12", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "A2000 (AI ~2000 words)", "price": "19", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "A3000 (AI ~3000 words)", "price": "28", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "H1000 (Human ~1000 words)", "price": "24", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "H2000 (Human ~2000 words)", "price": "39", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "H3000 (Human ~3000 words)", "price": "56", "priceCurrency": "USD" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "SEO Content Writing", "item": "https://hevaseo.com/content" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "Does the Content Score & Methodology come with every article?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every article — AI-powered or human-written — is delivered with a Content Score and a Methodology report showing exactly how it was researched and written: voice, sources, search intent, keywords & density, readability, E-E-A-T and originality. No black box." } },
          { "@type": "Question", "name": "Will AI content get penalized by Google?", "acceptedAnswer": { "@type": "Answer", "text": "No. Google rewards helpful content regardless of how it's produced. Our AI tier is edited by a human, optimized on-page, and passes plagiarism and AI-detection checks before delivery. For sites that need maximum trust, the human-written tier adds deeper E-E-A-T." } },
          { "@type": "Question", "name": "How many revisions are included?", "acceptedAnswer": { "@type": "Answer", "text": "Revisions are included per package against the agreed brief and outline. We confirm the brief, outline and target keyword before writing, so the first draft already matches your direction." } },
          { "@type": "Question", "name": "Is keyword research included?", "acceptedAnswer": { "@type": "Answer", "text": "You can supply your own keywords, or link an order from our Keyword Research service. We optimize each article around the target keyword and a safe density." } },
          { "@type": "Question", "name": "Where do I see the score and sources?", "acceptedAnswer": { "@type": "Answer", "text": "Each article gets a single URL showing the Content Score, the full Methodology (voice, sources, intent, keywords, readability, E-E-A-T, originality) and a live preview of the article — with downloads for HTML, DOC, TXT and images." } },
          { "@type": "Question", "name": "What formats do I receive?", "acceptedAnswer": { "@type": "Answer", "text": "An HTML live preview (as it would look on your site), plus DOC, TXT and an image set, all from one report URL alongside the Content Score and Methodology." } },
          { "@type": "Question", "name": "Is there a discount for multiple articles?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — orders of 10 or more articles get an additional 10% off. Tell us your volume and we'll quote a content plan." } }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* ===== Page flourishes — SEO Content Writing ===== */
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .hero-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    @property --tkwv { syntax: '<number>'; inherits: false; initial-value: 0; }

    .tkw-gauge { position: relative; width: 84px; height: 84px; border-radius: 50%;
      display: grid; place-items: center; --tkwv: 0;
      background: conic-gradient(var(--gc, hsl(var(--primary))) calc(var(--tkwv) * 1%), hsl(var(--muted)) 0); }
    .tkw-gauge::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: hsl(var(--card)); }
    .tkw-gauge b { position: relative; font-family: '"Inter Tight"', Inter, sans-serif; font-weight: 700; font-size: 1.3rem; line-height: 1; }
    [data-reveal].is-visible .tkw-gauge { transition: --tkwv 1.5s cubic-bezier(.16,1,.3,1); transition-delay: var(--gd, .2s); --tkwv: var(--to, 0); }
    .tkw-gauge.lg { width: 104px; height: 104px; }
    .tkw-gauge.lg::before { inset: 7px; }
    .tkw-gauge.lg b { font-size: 1.7rem; }

    .tkw-bar { position: relative; height: 6px; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
    .tkw-bar > i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #22c55e, #16a34a); }
    [data-reveal].is-visible .tkw-bar > i { animation: tkwBar 1.4s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--bd, .3s); }
    @keyframes tkwBar { to { width: var(--bw, 100%); } }

    .tkw-scan { position: relative; overflow: hidden; }
    .tkw-scan::after { content: ""; position: absolute; left: 0; right: 0; top: -42%; height: 36%; pointer-events: none; z-index: 5;
      background: linear-gradient(180deg, hsl(var(--primary) / .16), transparent);
      animation: tkwScan 3.6s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes tkwScan { 0% { transform: translateY(0); } 100% { transform: translateY(380%); } }

    .tkw-chip { position: absolute; z-index: 30; display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; border: 1px solid hsl(var(--border)); background: hsl(var(--card) / .92);
      padding: .45rem .8rem; font-size: .78rem; font-weight: 600; white-space: nowrap;
      box-shadow: 0 10px 28px hsl(213 50% 20% / .14); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      animation: tkwFloat 6s ease-in-out infinite; }
    .dark .tkw-chip { box-shadow: 0 10px 28px hsl(0 0% 0% / .4); }
    .tkw-chip.d2 { animation-duration: 7.4s; animation-delay: -2.2s; }
    .tkw-chip.d3 { animation-duration: 8.6s; animation-delay: -4.1s; }
    @keyframes tkwFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-11px); } }

    .tkw-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .tkw-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .tkw-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }
    .tkw-ic { transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
    .tkw-card:hover .tkw-ic, .tkw-step:hover .tkw-ic { transform: scale(1.14) rotate(-7deg); }

    .tkw-figure { position: relative; height: 10.5rem; overflow: hidden;
      background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .14), transparent 58%),
        radial-gradient(hsl(var(--primary) / .13) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .2), transparent 58%),
        radial-gradient(hsl(var(--primary) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure svg { position: relative; transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .tkw-card:hover .tkw-figure svg { transform: scale(1.04); }
    .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(213 50% 25% / .15)); }
    .dark .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(0 0% 0% / .5)); }
    .tkw-figure .glow { filter: drop-shadow(0 0 5px hsl(var(--primary) / .5)); }
    .tkw-guar { transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s ease; }
    .tkw-guar:hover { transform: translateY(-2px); box-shadow: 0 10px 24px hsl(213 60% 30% / .18); }
    .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .13), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .12) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .22), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure .glow-warn { filter: drop-shadow(0 0 5px hsl(var(--destructive) / .45)); }
    .tkw-arc { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-arc { animation: tkwArc 1.5s cubic-bezier(.16,1,.3,1) .2s forwards; }
    @keyframes tkwArc { to { stroke-dashoffset: var(--arc, 10); } }
    .tkw-draw { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-draw { animation: tkwDraw 1.6s cubic-bezier(.16,1,.3,1) .25s forwards; }
    @keyframes tkwDraw { to { stroke-dashoffset: 0; } }
    .tkw-pop { opacity: 0; transform: scale(.5); transform-box: fill-box; transform-origin: center; }
    [data-reveal].is-visible .tkw-pop { animation: tkwPop .55s cubic-bezier(.34,1.56,.64,1) forwards; }
    .tkw-pop.p1 { animation-delay: .25s; } .tkw-pop.p2 { animation-delay: .4s; }
    .tkw-pop.p3 { animation-delay: .55s; } .tkw-pop.p4 { animation-delay: .7s; } .tkw-pop.p5 { animation-delay: .85s; }
    @keyframes tkwPop { to { opacity: 1; transform: scale(1); } }

    .tkw-grid > [data-reveal]:nth-child(2) { transition-delay: .07s; }
    .tkw-grid > [data-reveal]:nth-child(3) { transition-delay: .14s; }
    .tkw-grid > [data-reveal]:nth-child(4) { transition-delay: .21s; }
    .tkw-grid > [data-reveal]:nth-child(5) { transition-delay: .28s; }
    .tkw-grid > [data-reveal]:nth-child(6) { transition-delay: .35s; }

    .tkw-num { background: linear-gradient(135deg, hsl(var(--primary)), hsl(199 95% 62%)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    .tkw-shine { position: relative; overflow: hidden; }
    .tkw-shine::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 30%, hsl(0 0% 100% / .55) 50%, transparent 70%);
      transform: translateX(-130%); animation: tkwShine 3.4s ease-in-out infinite; }
    @keyframes tkwShine { 0%, 55% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }

    .tkw-live { position: relative; }
    .tkw-live::before { content: ""; position: absolute; inset: -5px; border-radius: 999px; border: 2px solid hsl(142 70% 45% / .6); animation: tkwPing 1.8s ease-out infinite; }
    @keyframes tkwPing { 0% { transform: scale(.5); opacity: .9; } 100% { transform: scale(1.9); opacity: 0; } }

    /* === content-specific === */
    /* "Content Score included" badge — the hallmark, green */
    .cw-score { display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; padding: .3rem .7rem; font-size: .72rem; font-weight: 700; letter-spacing: .01em;
      background: linear-gradient(120deg, hsl(142 72% 45% / .16), hsl(142 72% 45% / .06));
      color: hsl(142 64% 32%); border: 1px solid hsl(142 64% 42% / .35); }
    .dark .cw-score { color: hsl(142 70% 62%); border-color: hsl(142 64% 50% / .4); }
    /* methodology chip */
    .cw-tag { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px;
      padding: .2rem .55rem; font-size: .68rem; font-weight: 600; background: hsl(var(--primary) / .1); color: hsl(var(--primary)); }
    .cw-pkg { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .cw-pkg:hover { transform: translateY(-5px); border-color: hsl(var(--primary) / .45); box-shadow: 0 18px 40px hsl(213 60% 28% / .14); }
    .dark .cw-pkg:hover { box-shadow: 0 18px 40px hsl(0 0% 0% / .45); }
    .cw-flow { position: relative; }
    @media (min-width: 1024px) {
      .cw-flow::before { content: ""; position: absolute; top: 2.25rem; left: 11%; right: 11%; height: 2px; z-index: 0;
        background: repeating-linear-gradient(90deg, hsl(var(--primary) / .45) 0 10px, transparent 10px 20px); }
    }
    .cw-step-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .cw-step-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .cw-step-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }

    /* AI/Human contribution split */
    .cw-fig { transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .tkw-card:hover .cw-fig { transform: scale(1.03); }
    .cw-split { display: flex; gap: 2px; height: 1.5rem; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; box-shadow: inset 0 1px 2px hsl(213 30% 20% / .08); }
    .cw-split > span { height: 100%; width: 0; transition: width 1.1s cubic-bezier(.16,1,.3,1) .25s; }
    .cw-split > span:first-child { border-radius: 999px 0 0 999px; }
    .cw-split > span:last-child { border-radius: 0 999px 999px 0; }
    [data-reveal].is-visible .cw-split > span { width: var(--w); }

    @media (prefers-reduced-motion: reduce) {
      .tkw-scan::after, .tkw-chip, .tkw-shine::after, .tkw-live::before { animation: none !important; }
      .cw-split > span { transition: none !important; width: var(--w) !important; }
      .cw-fig { transition: none !important; }
      .tkw-chip { transform: none !important; }
      [data-reveal].is-visible .tkw-gauge { transition: none; --tkwv: var(--to,0); }
      [data-reveal].is-visible .tkw-bar > i { animation: none; width: var(--bw,100%); }
      .tkw-arc, .tkw-draw { stroke-dashoffset: 0 !important; animation: none !important; }
      .tkw-pop { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>

<main id="top">

    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-6 pb-16 lg:pt-8 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-blob" aria-hidden="true" style="top:-6rem;right:-4rem;width:26rem;height:26rem;"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 lg:px-8">
        <nav data-reveal class="mb-8 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/#top" class="transition hover:text-primary">Home</a>
          <i class="ph-bold ph-caret-right text-xs"></i>
          <span class="text-foreground">SEO Content Writing</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-primary shadow-sm"><i class="ph-fill ph-pen-nib"></i> AI-powered &amp; human-written</span>
            <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl">
              Content that ranks — and you can <span class="text-primary">see why.</span>
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
              SEO articles that are <b class="font-semibold text-foreground">Google-safe, on-page optimized, and E-E-A-T-ready</b>. Every piece ships with a <b class="font-semibold text-foreground">Content Score &amp; Methodology report</b> — voice, sources, intent, keywords, readability, E-E-A-T and originality, all on the record.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#plans" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:-translate-y-px hover:bg-primary/90 active:scale-[0.98]">
                See packages &amp; pricing <i class="ph-bold ph-arrow-down"></i>
              </a>
              <a href="#aivshuman" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">
                AI or human-written?
              </a>
            </div>
            <div class="mt-7 flex flex-wrap gap-2.5">
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-gauge text-sm"></i></span> Content Score on every article</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-shield-check text-sm"></i></span> Google-safe, plagiarism-checked</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-files text-sm"></i></span> HTML · DOC · TXT · images</span>
            </div>

            <!-- SAMPLE FIGURES: replace with real numbers -->
            <div data-reveal class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl border border-border bg-card/70 p-3 pr-5 shadow-sm backdrop-blur">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-2.5">
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-xs font-bold text-white ring-2 ring-card">M</span>
