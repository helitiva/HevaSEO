---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Backlink Indexer — Get Your Links Into Google, Fast | HevaSEO"
  description="Push your backlinks into Google's index fast. Pay per link — cheaper at volume (from $0.008, down to $0.004). Per-link index status and a HevaSEO plugin to verify it yourself. Already included free with every Backlink package."
  keywords="backlink indexer, link indexing service, get backlinks indexed, google index links, index checker plugin, fast link indexing"
  ogDescription="Pay-per-link backlink indexing — from $0.008/link, cheaper at volume. Per-link index status + a plugin to verify. Free with every Backlink package."
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "Backlink Indexer",
        "serviceType": "Pay-per-link backlink indexing with per-link status verification",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "Usage-based backlink indexing: submit a list of URLs and we push them into Google's index, with a per-link status report and a HevaSEO plugin to verify. Pricing is per link and drops at higher volumes. Indexing is included free with every Backlink package.",
        "offers": [
          { "@type": "Offer", "name": "Indexer — standard rate", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "0.008", "priceCurrency": "USD", "unitText": "per link" } },
          { "@type": "Offer", "name": "Indexer — over 5,000 links", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "0.006", "priceCurrency": "USD", "unitText": "per link" } },
          { "@type": "Offer", "name": "Indexer — over 20,000 links", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "0.004", "priceCurrency": "USD", "unitText": "per link" } }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Backlink Indexer", "item": "https://hevaseo.com/indexer" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "How long does indexing take?", "acceptedAnswer": { "@type": "Answer", "text": "Most links are submitted and crawled within days. You can watch each link move through pending → submitting → completed in your report, and verify the final state yourself with the HevaSEO plugin." } },
          { "@type": "Question", "name": "What index rate can I expect?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the quality of the links. Strong, content-backed links index at very high rates; thin or low-quality links index lower. Your report shows the exact percentage indexed so there's no guesswork." } },
          { "@type": "Question", "name": "What if a link doesn't get indexed?", "acceptedAnswer": { "@type": "Answer", "text": "We re-submit links that don't index on the first pass. The report flags anything still pending so you always know the real status." } },
          { "@type": "Question", "name": "How is pricing calculated?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing is per link and gets cheaper at volume: $0.008 per link by default, $0.006 over 5,000 links, and $0.004 over 20,000 links. You pay only for the links you submit — no packages, no minimum." } },
          { "@type": "Question", "name": "How do I install the plugin?", "acceptedAnswer": { "@type": "Answer", "text": "The HevaSEO plugin installs in a click from your dashboard. It lets you check the index status of any link on demand, including links you didn't order through us." } },
          { "@type": "Question", "name": "Isn't indexing included with backlinks?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — every Backlink package already includes our Indexer free. This page is for standalone indexing of links you built elsewhere or want re-indexed." } }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* ===== Page flourishes — Indexer ===== */
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .hero-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    @property --tkwv { syntax: '<number>'; inherits: false; initial-value: 0; }

    .tkw-gauge { position: relative; width: 84px; height: 84px; border-radius: 50%;
      display: grid; place-items: center; --tkwv: 0;
      background: conic-gradient(var(--gc, hsl(var(--primary))) calc(var(--tkwv) * 1%), hsl(var(--muted)) 0); }
    .tkw-gauge::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: hsl(var(--card)); }
    .tkw-gauge b { position: relative; font-family: '"Inter Tight"', Inter, sans-serif; font-weight: 700; font-size: 1.3rem; line-height: 1; }
    [data-reveal].is-visible .tkw-gauge { transition: --tkwv 1.5s cubic-bezier(.16,1,.3,1); transition-delay: var(--gd, .2s); --tkwv: var(--to, 0); }
    .tkw-gauge.sm { width: 70px; height: 70px; }
    .tkw-gauge.sm::before { inset: 5px; }
    .tkw-gauge.sm b { font-size: 1.05rem; }

    .tkw-bar { position: relative; height: 6px; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
    .tkw-bar > i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #22c55e, #16a34a); }
    [data-reveal].is-visible .tkw-bar > i { animation: tkwBar 1.4s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--bd, .3s); }
    @keyframes tkwBar { to { width: var(--bw, 100%); } }

    .tkw-scan { position: relative; overflow: hidden; }
    .tkw-scan::after { content: ""; position: absolute; left: 0; right: 0; top: -42%; height: 36%; pointer-events: none; z-index: 5;
      background: linear-gradient(180deg, hsl(var(--primary) / .16), transparent);
      animation: tkwScan 3.6s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes tkwScan { 0% { transform: translateY(0); } 100% { transform: translateY(380%); } }

    .tkw-chip { position: absolute; z-index: 30; display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; border: 1px solid hsl(var(--border)); background: hsl(var(--card) / .92);
      padding: .45rem .8rem; font-size: .78rem; font-weight: 600; white-space: nowrap;
      box-shadow: 0 10px 28px hsl(213 50% 20% / .14); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      animation: tkwFloat 6s ease-in-out infinite; }
    .dark .tkw-chip { box-shadow: 0 10px 28px hsl(0 0% 0% / .4); }
    .tkw-chip.d2 { animation-duration: 7.4s; animation-delay: -2.2s; }
    .tkw-chip.d3 { animation-duration: 8.6s; animation-delay: -4.1s; }
    @keyframes tkwFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-11px); } }

    .tkw-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .tkw-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .tkw-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }
    .tkw-ic { transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
    .tkw-card:hover .tkw-ic, .tkw-step:hover .tkw-ic { transform: scale(1.14) rotate(-7deg); }

    .tkw-figure { position: relative; height: 10.5rem; overflow: hidden;
      background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .14), transparent 58%),
        radial-gradient(hsl(var(--primary) / .13) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .2), transparent 58%),
        radial-gradient(hsl(var(--primary) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure svg { position: relative; transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .tkw-card:hover .tkw-figure svg { transform: scale(1.04); }
    .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(213 50% 25% / .15)); }
    .dark .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(0 0% 0% / .5)); }
    .tkw-figure .glow { filter: drop-shadow(0 0 5px hsl(var(--primary) / .5)); }
    .tkw-guar { transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s ease; }
    .tkw-guar:hover { transform: translateY(-2px); box-shadow: 0 10px 24px hsl(213 60% 30% / .18); }
    .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .13), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .12) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .22), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure .glow-warn { filter: drop-shadow(0 0 5px hsl(var(--destructive) / .45)); }
    .tkw-arc { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-arc { animation: tkwArc 1.5s cubic-bezier(.16,1,.3,1) .2s forwards; }
    @keyframes tkwArc { to { stroke-dashoffset: var(--arc, 10); } }
    .tkw-draw { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-draw { animation: tkwDraw 1.6s cubic-bezier(.16,1,.3,1) .25s forwards; }
    @keyframes tkwDraw { to { stroke-dashoffset: 0; } }
    .tkw-pop { opacity: 0; transform: scale(.5); transform-box: fill-box; transform-origin: center; }
    [data-reveal].is-visible .tkw-pop { animation: tkwPop .55s cubic-bezier(.34,1.56,.64,1) forwards; }
    .tkw-pop.p1 { animation-delay: .25s; } .tkw-pop.p2 { animation-delay: .4s; }
    .tkw-pop.p3 { animation-delay: .55s; } .tkw-pop.p4 { animation-delay: .7s; } .tkw-pop.p5 { animation-delay: .85s; }
    @keyframes tkwPop { to { opacity: 1; transform: scale(1); } }

    .tkw-grid > [data-reveal]:nth-child(2) { transition-delay: .07s; }
    .tkw-grid > [data-reveal]:nth-child(3) { transition-delay: .14s; }
    .tkw-grid > [data-reveal]:nth-child(4) { transition-delay: .21s; }

    .tkw-num { background: linear-gradient(135deg, hsl(var(--primary)), hsl(199 95% 62%)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    .tkw-live { position: relative; }
    .tkw-live::before { content: ""; position: absolute; inset: -5px; border-radius: 999px; border: 2px solid hsl(142 70% 45% / .6); animation: tkwPing 1.8s ease-out infinite; }
    @keyframes tkwPing { 0% { transform: scale(.5); opacity: .9; } 100% { transform: scale(1.9); opacity: 0; } }

    /* === indexer-specific === */
    .idx-pill { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px;
      padding: .12rem .5rem; font-size: .66rem; font-weight: 700; white-space: nowrap; }
    .idx-pill.done { background: hsl(142 64% 45% / .14); color: hsl(142 60% 34%); }
    .idx-pill.sub  { background: hsl(var(--primary) / .12); color: hsl(var(--primary)); }
    .idx-pill.pend { background: hsl(38 92% 50% / .15); color: hsl(32 80% 42%); }
    .dark .idx-pill.done { color: hsl(142 65% 60%); } .dark .idx-pill.pend { color: hsl(38 92% 62%); }
    .idx-spin { animation: idxSpin 1s linear infinite; }
    @keyframes idxSpin { to { transform: rotate(360deg); } }

    /* volume tier rows + active highlight (driven by calculator) */
    .idx-tier { transition: border-color .25s ease, background-color .25s ease, transform .25s ease; }
    .idx-tier.is-active { border-color: hsl(var(--primary)); background: hsl(var(--primary) / .06); transform: translateX(2px); }
    .idx-tier.is-active .idx-tier-dot { background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }

    .idx-chip { transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
    .idx-chip.is-active { background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); border-color: hsl(var(--primary)); }

    .cw-flow { position: relative; }
    @media (min-width: 1024px) {
      .cw-flow::before { content: ""; position: absolute; top: 2.25rem; left: 11%; right: 11%; height: 2px; z-index: 0;
        background: repeating-linear-gradient(90deg, hsl(var(--primary) / .45) 0 10px, transparent 10px 20px); }
    }
    .cw-step-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .cw-step-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .cw-step-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }

    @media (prefers-reduced-motion: reduce) {
      .tkw-scan::after, .tkw-chip, .tkw-live::before, .idx-spin { animation: none !important; }
      .tkw-chip { transform: none !important; }
      [data-reveal].is-visible .tkw-gauge { transition: none; --tkwv: var(--to,0); }
      [data-reveal].is-visible .tkw-bar > i { animation: none; width: var(--bw,100%); }
      .tkw-arc, .tkw-draw { stroke-dashoffset: 0 !important; animation: none !important; }
      .tkw-pop { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>

<main id="top">

    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-6 pb-16 lg:pt-8 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-blob" aria-hidden="true" style="top:-6rem;right:-4rem;width:26rem;height:26rem;"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 lg:px-8">
        <nav data-reveal class="mb-8 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/#top" class="transition hover:text-primary">Home</a>
          <i class="ph-bold ph-caret-right text-xs"></i>
          <span class="text-foreground">Backlink Indexer</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-primary shadow-sm"><i class="ph-fill ph-magnifying-glass"></i> Pay per link · cheaper at volume</span>
            <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl">
              Get your backlinks <span class="text-primary">into Google</span> — fast.
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
              A link Google never indexes passes <b class="font-semibold text-foreground">zero authority</b>. Submit your URLs and we push them into the index — <b class="font-semibold text-foreground">priced per link, from $0.008</b>, with a per-link status report and a plugin to verify it yourself.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#calculator" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:-translate-y-px hover:bg-primary/90 active:scale-[0.98]">
                Calculate your price <i class="ph-bold ph-calculator"></i>
              </a>
              <a href="#contact" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">
                Submit your links
              </a>
            </div>
            <div class="mt-7 flex flex-wrap gap-2.5">
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-coins text-sm"></i></span> From $0.008 / link</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-list-checks text-sm"></i></span> Per-link status</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-puzzle-piece text-sm"></i></span> Verify with the plugin</span>
            </div>

            <!-- SAMPLE FIGURES: replace with real numbers -->
            <div data-reveal class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl border border-border bg-card/70 p-3 pr-5 shadow-sm backdrop-blur">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-2.5">
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-xs font-bold text-white ring-2 ring-card">M</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 text-xs font-bold text-white ring-2 ring-card">H</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-violet-400 to-violet-600 text-xs font-bold text-white ring-2 ring-card">T</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-primary text-[10px] font-bold text-primary-foreground ring-2 ring-card">+1k</span>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex text-amber-400"><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i></span>
                    <span class="text-sm font-bold text-foreground">4.9/5</span>
                  </div>
                  <p class="text-xs text-muted-foreground"><b class="font-bold text-foreground"><span data-count="9">0</span>M+</b> links indexed</p>
                </div>
              </div>
              <span class="hidden h-10 w-px bg-border sm:block"></span>
              <div class="flex items-center gap-5">
                <div><p class="font-display text-xl font-bold text-primary">$0.004</p><p class="text-[11px] text-muted-foreground">Per link at volume</p></div>
                <div><p class="font-display text-xl font-bold text-primary"><span data-count="100">0</span>%</p><p class="text-[11px] text-muted-foreground">Status reported</p></div>
              </div>
            </div>
          </div>

          <!-- hero visual: indexer queue -->
          <div data-reveal class="relative">
            <span class="tkw-chip -left-3 top-6 text-emerald-500"><i class="ph-fill ph-check-circle"></i> 88% indexed</span>
            <span class="tkw-chip d2 -right-2 top-1/3 text-primary"><i class="ph-fill ph-lightning"></i> Submitting</span>
            <span class="tkw-chip d3 -left-2 bottom-10 text-violet-500"><i class="ph-fill ph-puzzle-piece"></i> Plugin check</span>

            <div class="tkw-scan rounded-2xl border border-border bg-card p-6 shadow-xl shadow-primary/5 lg:p-7">
              <div class="flex items-center gap-2 pb-4">
                <span class="flex gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-red-400"></i><i class="h-2.5 w-2.5 rounded-full bg-amber-400"></i><i class="h-2.5 w-2.5 rounded-full bg-green-400"></i></span>
                <span class="ml-1 inline-flex items-center gap-1.5 rounded-md bg-muted px-2.5 py-1 text-xs text-muted-foreground"><i class="ph-bold ph-list-checks"></i> Indexer queue</span>
                <span class="ml-auto inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-500"><span class="tkw-live grid h-2 w-2 place-items-center rounded-full bg-emerald-500"></span> Live</span>
              </div>

              <div class="mb-4 flex items-center gap-4 rounded-xl border border-border bg-muted/40 p-4">
                <div class="tkw-gauge sm shrink-0" style="--to:88;--gc:#22c55e;--gd:.2s"><b class="text-green-500"><span data-count="88">0</span>%</b></div>
                <div class="grid flex-1 grid-cols-3 gap-x-3 text-center">
                  <div><p class="font-display text-lg font-bold text-foreground"><span data-count="1000">0</span></p><p class="text-[10px] text-muted-foreground">Submitted</p></div>
                  <div><p class="font-display text-lg font-bold text-foreground"><span data-count="884">0</span></p><p class="text-[10px] text-muted-foreground">Indexed</p></div>
                  <div><p class="font-display text-lg font-bold text-foreground"><span data-count="116">0</span></p><p class="text-[10px] text-muted-foreground">In queue</p></div>
                </div>
              </div>

              <div class="space-y-2 text-sm">
                <div class="flex items-center gap-3 rounded-lg border border-border bg-background px-3 py-2">
                  <i class="ph-bold ph-link text-muted-foreground"></i>
                  <span class="min-w-0 flex-1 truncate text-xs text-muted-foreground">techblog.com/post-a</span>
                  <span class="idx-pill done"><i class="ph-fill ph-check-circle"></i> Indexed</span>
                </div>
                <div class="flex items-center gap-3 rounded-lg border border-border bg-background px-3 py-2">
                  <i class="ph-bold ph-link text-muted-foreground"></i>
                  <span class="min-w-0 flex-1 truncate text-xs text-muted-foreground">guildreview.net/x</span>
                  <span class="idx-pill sub"><i class="ph-bold ph-circle-notch idx-spin"></i> Submitting</span>
                </div>
                <div class="flex items-center gap-3 rounded-lg border border-border bg-background px-3 py-2">
                  <i class="ph-bold ph-link text-muted-foreground"></i>
                  <span class="min-w-0 flex-1 truncate text-xs text-muted-foreground">profilehub.org/y</span>
                  <span class="idx-pill pend"><i class="ph-fill ph-clock"></i> Pending</span>
                </div>
              </div>

              <div class="mt-4">
                <div class="mb-1 flex items-center justify-between text-xs"><span class="text-muted-foreground">Indexing progress</span><span class="font-medium text-green-500">884 / 1,000</span></div>
