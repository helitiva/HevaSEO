  <script is:inline>
(function () {
      // ---- lead form package capture ----
      var pkgField = document.getElementById('lead-package');
      var input = document.getElementById('cta-email');
      var status = document.getElementById('lead-status');
      document.querySelectorAll('a[data-goi]').forEach(function (a) {
        a.addEventListener('click', function () {
          var name = a.getAttribute('data-goi');
          if (pkgField) pkgField.value = name;
          if (input) input.placeholder = 'Ask about: ' + name.split(' · ')[0];
          if (status) status.textContent = 'You’re interested in the Indexer. Leave your contact details and link list!';
        });
      });

      // ---- price calculator ----
      var countEl = document.getElementById('idx-count');
      var rangeEl = document.getElementById('idx-range');
      var rateEl = document.getElementById('idx-rate');
      var totalEl = document.getElementById('idx-total');
      var saveEl = document.getElementById('idx-save');
      var tiers = [document.getElementById('idx-tier-0'), document.getElementById('idx-tier-1'), document.getElementById('idx-tier-2')];
      var chips = Array.prototype.slice.call(document.querySelectorAll('.idx-chip'));
      if (!countEl) return;

      function rateFor(n) { if (n > 20000) return 0.004; if (n > 5000) return 0.006; return 0.008; }
      function tierIndex(n) { if (n > 20000) return 2; if (n > 5000) return 1; return 0; }
      function fmtMoney(v) { return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

      function update(n) {
        n = Math.max(0, Math.floor(n || 0));
        var rate = rateFor(n);
        var total = n * rate;
        if (rateEl) rateEl.textContent = '$' + rate.toFixed(3);
        if (totalEl) totalEl.textContent = fmtMoney(total);
        var ti = tierIndex(n);
        tiers.forEach(function (t, i) { if (t) t.classList.toggle('is-active', i === ti); });
        chips.forEach(function (c) { c.classList.toggle('is-active', parseInt(c.getAttribute('data-count'), 10) === n); });
        if (saveEl) {
          if (ti === 0) { saveEl.innerHTML = '<i class="ph-bold ph-tag"></i> Standard rate — submit 5,000+ to save'; }
          else {
            var saved = n * (0.008 - rate);
            var pct = Math.round((0.008 - rate) / 0.008 * 100);
            saveEl.innerHTML = '<i class="ph-bold ph-trend-down"></i> Saving ' + pct + '% — ' + fmtMoney(saved) + ' off the standard rate';
          }
        }
      }

      countEl.addEventListener('input', function () { if (rangeEl) rangeEl.value = Math.min(50000, Math.max(100, parseInt(countEl.value || '0', 10) || 0)); update(parseInt(countEl.value || '0', 10)); });
      if (rangeEl) rangeEl.addEventListener('input', function () { countEl.value = rangeEl.value; update(parseInt(rangeEl.value, 10)); });
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          var n = parseInt(c.getAttribute('data-count'), 10);
          countEl.value = n; if (rangeEl) rangeEl.value = Math.min(50000, n);
          update(n);
        });
      });
      update(parseInt(countEl.value || '1000', 10));
    })();
  </script>

