---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingGrid from '../components/PricingGrid.astro';
import ComparisonTable from '../components/ComparisonTable.astro';

const optimizationTiers = [
  { name: 'Basic', subtitle: 'Make a slow site fast.', icon: 'ph-lightning', hue: 'sky', price: '$40', strike: '$100', delivery: '~3–5 days', footerBadge: 'Website audit included', cta: 'Choose Basic', goi: 'Basic · $40', features: ['Full website audit', 'Speed optimization — compression, caching, minify, lazy-load', 'Mobile &amp; responsive fixes', 'Source backup + deploy', 'Before/after report'] },
  { name: 'Standard', subtitle: 'Fast, clean & AI-ready.', icon: 'ph-sparkle', hue: 'violet', price: '$79', strike: '$197', delivery: '~5–7 days', popular: true, everythingIn: 'Everything in Basic, plus', footerBadge: 'Website audit included', cta: 'Choose Standard', goi: 'Standard · $79', features: ['On-page SEO + schema markup', 'Core Web Vitals into the green', '<b class="font-semibold text-foreground">AI-ready / GEO</b> — structured, entity optimization', '1 month of support'] },
  { name: 'Ultra', subtitle: 'Deep technical + advanced GEO.', icon: 'ph-crown', hue: 'amber', price: 'Consult', delivery: '~7–10 days', everythingIn: 'Everything in Standard, plus', footerBadge: 'Website audit included', cta: 'Request a consult', goi: 'Ultra · consult', features: ['Deep technical SEO', 'JavaScript / render optimization', 'Internal linking architecture', 'Advanced GEO + 3 months support'] },
  { name: 'Custom', subtitle: 'Large or complex sites.', icon: 'ph-sliders-horizontal', hue: 'emerald', price: 'Consult', delivery: 'By scope', footerBadge: 'Website audit included', cta: 'Talk to us', goi: 'Custom · consult', features: ['Tailored to your codebase &amp; scale', 'Large catalogs, headless &amp; webapps', 'Phased rollout &amp; staging', 'Dedicated specialist', 'SLA &amp; support by agreement'] },
];

const optimizationCompareColumns = [
  { label: 'Basic', icon: 'ph-lightning', sub: '$40' },
  { label: 'Standard', icon: 'ph-sparkle', sub: '$79', highlight: true },
  { label: 'Ultra', icon: 'ph-crown', sub: 'Consult' },
  { label: 'Custom', icon: 'ph-sliders-horizontal', sub: 'Consult' },
];

const optimizationCompareRows = [
  { label: 'Full website audit', cells: [true, true, true, true] },
  { label: 'Speed optimization', cells: ['Core', 'Core', 'Advanced', 'Advanced'] },
  { label: 'Mobile & responsive fixes', cells: [true, true, true, true] },
  { label: 'On-page SEO', cells: [false, true, true, true] },
  { label: 'Schema markup', cells: [false, true, true, true] },
  { label: 'Core Web Vitals', cells: [false, true, true, true] },
  { label: 'AI-ready / GEO', cells: [false, 'Yes', 'Advanced', 'Advanced'] },
  { label: 'Deep technical SEO', cells: [false, false, true, true] },
  { label: 'JS / render optimization', cells: [false, false, true, true] },
  { label: 'Internal linking', cells: [false, false, true, true] },
  { label: 'Source backup + deploy', cells: [true, true, true, true] },
  { label: 'Before/after report', cells: [true, true, true, true] },
  { label: 'Support', cells: [false, '1 month', '3 months', 'By agreement'] },
];
---
<BaseLayout
  title="Website Optimization — Faster, Cleaner, AI-Ready | HevaSEO"
  description="HevaSEO website optimization: speed & Core Web Vitals, technical & on-page SEO, schema, and AI-ready (GEO) optimization. Every plan starts with a full website audit, your source is backed up, and we deploy the optimized site. Plans from $40."
  keywords="website optimization, website speed optimization, core web vitals optimization, technical seo service, ai-ready website, generative engine optimization, geo seo, pagespeed optimization"
  ogDescription="Make your website fast, technically clean and AI-ready — measured before and after, deployed for you. Every plan includes a full website audit. From $40."
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "Website Optimization",
        "serviceType": "Website speed, technical SEO & AI-readiness optimization",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "Website optimization: speed and Core Web Vitals, technical and on-page SEO, schema markup, and AI-ready (GEO) optimization. Every plan starts with a full website audit, your source code is backed up before any change, and the optimized site is deployed for you.",
        "offers": [
          { "@type": "Offer", "name": "Basic", "price": "40", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Standard", "price": "79", "priceCurrency": "USD" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Website Optimization", "item": "https://hevaseo.com/website-optimization" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "Is the website audit really included in every plan?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every plan — Basic, Standard, Ultra and Custom — starts with a full website audit. We measure speed, Core Web Vitals, technical and on-page SEO, and AI-readiness first, so the work is targeted and you get a clear before-and-after report at delivery." } },
          { "@type": "Question", "name": "Will optimizing break my live website?", "acceptedAnswer": { "@type": "Answer", "text": "No. We back up your full source code before making any change. We optimize on a copy, verify everything works, then deploy. If anything looks off, we can roll back to the backup immediately." } },
          { "@type": "Question", "name": "What access do you need?", "acceptedAnswer": { "@type": "Answer", "text": "We only need your website URL to start and to run the audit. Once you approve the plan, we request access to your source code or CMS (hosting, admin or repository) so we can apply the optimizations and deploy." } },
          { "@type": "Question", "name": "How much improvement can I expect?", "acceptedAnswer": { "@type": "Answer", "text": "After the audit we predict the realistic lift for your site and show it before we start. Typical results include large PageSpeed gains, passing Core Web Vitals, and a higher technical SEO score — all documented in the before-and-after report." } },
          { "@type": "Question", "name": "What does AI-ready / GEO optimization mean?", "acceptedAnswer": { "@type": "Answer", "text": "GEO (Generative Engine Optimization) makes your content readable, citable and surfaceable by AI search and generative engines. We add structured data, strengthen entity and answer-ready content, and clean up markup so AI systems can understand and quote your pages. It is included from the Standard plan up." } },
          { "@type": "Question", "name": "Which platforms do you support?", "acceptedAnswer": { "@type": "Answer", "text": "WordPress, custom-coded sites, headless and most common stacks. For large or unusual sites we run a Custom plan scoped to your codebase after the audit." } }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* ===== Page flourishes — Website Optimization ===== */
    /* shared hero background (synced across service pages) */
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .hero-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    @property --tkwv { syntax: '<number>'; inherits: false; initial-value: 0; }

    /* animated score gauges (conic ring fills on reveal) */
    .tkw-gauge { position: relative; width: 84px; height: 84px; border-radius: 50%;
      display: grid; place-items: center; --tkwv: 0;
      background: conic-gradient(var(--gc, hsl(var(--primary))) calc(var(--tkwv) * 1%), hsl(var(--muted)) 0); }
    .tkw-gauge::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: hsl(var(--card)); }
    .tkw-gauge b { position: relative; font-family: '"Inter Tight"', Inter, sans-serif; font-weight: 700; font-size: 1.3rem; line-height: 1; }
    [data-reveal].is-visible .tkw-gauge { transition: --tkwv 1.5s cubic-bezier(.16,1,.3,1); transition-delay: var(--gd, .2s); --tkwv: var(--to, 0); }
    .tkw-gauge.sm { width: 64px; height: 64px; }
    .tkw-gauge.sm::before { inset: 5px; }
    .tkw-gauge.sm b { font-size: 1.05rem; }

    /* animated metric bars */
    .tkw-bar { position: relative; height: 6px; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
    .tkw-bar > i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #22c55e, #16a34a); }
    [data-reveal].is-visible .tkw-bar > i { animation: tkwBar 1.4s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--bd, .3s); }
    @keyframes tkwBar { to { width: var(--bw, 100%); } }
    .tkw-bar.red > i { background: linear-gradient(90deg, #f87171, #dc2626); }

    /* scanning sheen across the scorecard */
    .tkw-scan { position: relative; overflow: hidden; }
    .tkw-scan::after { content: ""; position: absolute; left: 0; right: 0; top: -42%; height: 36%; pointer-events: none; z-index: 5;
      background: linear-gradient(180deg, hsl(var(--primary) / .16), transparent);
      animation: tkwScan 3.6s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes tkwScan { 0% { transform: translateY(0); } 100% { transform: translateY(380%); } }

    /* floating glass chips around hero card */
    .tkw-chip { position: absolute; z-index: 30; display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; border: 1px solid hsl(var(--border)); background: hsl(var(--card) / .92);
      padding: .45rem .8rem; font-size: .78rem; font-weight: 600; white-space: nowrap;
      box-shadow: 0 10px 28px hsl(213 50% 20% / .14); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      animation: tkwFloat 6s ease-in-out infinite; }
    .dark .tkw-chip { box-shadow: 0 10px 28px hsl(0 0% 0% / .4); }
    .tkw-chip.d2 { animation-duration: 7.4s; animation-delay: -2.2s; }
    .tkw-chip.d3 { animation-duration: 8.6s; animation-delay: -4.1s; }
    @keyframes tkwFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-11px); } }

    /* card hover lift + icon pop */
    .tkw-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .tkw-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .tkw-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }
    .tkw-ic { transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
    .tkw-card:hover .tkw-ic, .tkw-step:hover .tkw-ic { transform: scale(1.14) rotate(-7deg); }

    /* feature-card graphics */
    .tkw-figure { position: relative; height: 10.5rem; overflow: hidden;
      background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .14), transparent 58%),
        radial-gradient(hsl(var(--primary) / .13) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .2), transparent 58%),
        radial-gradient(hsl(var(--primary) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure svg { position: relative; transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .tkw-card:hover .tkw-figure svg { transform: scale(1.04); }
    .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(213 50% 25% / .15)); }
    .dark .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(0 0% 0% / .5)); }
    .tkw-figure .glow { filter: drop-shadow(0 0 5px hsl(var(--primary) / .5)); }
    /* hero guarantee pills */
    .tkw-guar { transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s ease; }
    .tkw-guar:hover { transform: translateY(-2px); box-shadow: 0 10px 24px hsl(213 60% 30% / .18); }
    /* warning (pain-point) variant — red tint */
    .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .13), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .12) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .22), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure .glow-warn { filter: drop-shadow(0 0 5px hsl(var(--destructive) / .45)); }
    .tkw-arc { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-arc { animation: tkwArc 1.5s cubic-bezier(.16,1,.3,1) .2s forwards; }
    @keyframes tkwArc { to { stroke-dashoffset: var(--arc, 10); } }
    .tkw-draw { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-draw { animation: tkwDraw 1.6s cubic-bezier(.16,1,.3,1) .25s forwards; }
    @keyframes tkwDraw { to { stroke-dashoffset: 0; } }
    .tkw-pop { opacity: 0; transform: scale(.5); transform-box: fill-box; transform-origin: center; }
    [data-reveal].is-visible .tkw-pop { animation: tkwPop .55s cubic-bezier(.34,1.56,.64,1) forwards; }
    .tkw-pop.p1 { animation-delay: .25s; } .tkw-pop.p2 { animation-delay: .4s; }
    .tkw-pop.p3 { animation-delay: .55s; } .tkw-pop.p4 { animation-delay: .7s; } .tkw-pop.p5 { animation-delay: .85s; }
    @keyframes tkwPop { to { opacity: 1; transform: scale(1); } }

    /* staggered reveal inside grids */
    .tkw-grid > [data-reveal]:nth-child(2) { transition-delay: .07s; }
    .tkw-grid > [data-reveal]:nth-child(3) { transition-delay: .14s; }
    .tkw-grid > [data-reveal]:nth-child(4) { transition-delay: .21s; }
    .tkw-grid > [data-reveal]:nth-child(5) { transition-delay: .28s; }
    .tkw-grid > [data-reveal]:nth-child(6) { transition-delay: .35s; }

    /* gradient number */
    .tkw-num { background: linear-gradient(135deg, hsl(var(--primary)), hsl(199 95% 62%)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    /* shimmer sweep on featured badge */
    .tkw-shine { position: relative; overflow: hidden; }
    .tkw-shine::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 30%, hsl(0 0% 100% / .55) 50%, transparent 70%);
      transform: translateX(-130%); animation: tkwShine 3.4s ease-in-out infinite; }
    @keyframes tkwShine { 0%, 55% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }

    /* pulsing live ring */
    .tkw-live { position: relative; }
    .tkw-live::before { content: ""; position: absolute; inset: -5px; border-radius: 999px; border: 2px solid hsl(142 70% 45% / .6); animation: tkwPing 1.8s ease-out infinite; }
    @keyframes tkwPing { 0% { transform: scale(.5); opacity: .9; } 100% { transform: scale(1.9); opacity: 0; } }

    /* === before/after compare bars (improvement section) === */
    .wo-cmp { position: relative; height: 8px; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
    .wo-cmp > i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 999px; }
    .wo-cmp > .b { background: linear-gradient(90deg, #fca5a5, #ef4444); z-index: 1; }
    .wo-cmp > .a { background: linear-gradient(90deg, #34d399, #16a34a); z-index: 2; box-shadow: 0 0 12px hsl(142 70% 45% / .5); }
    [data-reveal].is-visible .wo-cmp > .b { animation: tkwBar 1.1s cubic-bezier(.16,1,.3,1) .2s forwards; }
    [data-reveal].is-visible .wo-cmp > .a { animation: tkwBar 1.5s cubic-bezier(.16,1,.3,1) .55s forwards; }

    /* audit-included ribbon on every pricing card */
    .wo-audit { display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; padding: .3rem .7rem; font-size: .72rem; font-weight: 700; letter-spacing: .01em;
      background: linear-gradient(120deg, hsl(142 72% 45% / .16), hsl(142 72% 45% / .06));
      color: hsl(142 64% 32%); border: 1px solid hsl(142 64% 42% / .35); }
    .dark .wo-audit { color: hsl(142 70% 62%); border-color: hsl(142 64% 50% / .4); }

    /* connecting line for the process timeline */
    .wo-flow { position: relative; }
    @media (min-width: 1024px) {
      .wo-flow::before { content: ""; position: absolute; top: 2.25rem; left: 12%; right: 12%; height: 2px; z-index: 0;
        background: repeating-linear-gradient(90deg, hsl(var(--primary) / .45) 0 10px, transparent 10px 20px); }
    }
    .wo-step-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .wo-step-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .wo-step-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }

    @media (prefers-reduced-motion: reduce) {
      .tkw-scan::after, .tkw-chip, .tkw-shine::after, .tkw-live::before { animation: none !important; }
      .tkw-chip { transform: none !important; }
      [data-reveal].is-visible .tkw-gauge { transition: none; --tkwv: var(--to,0); }
      [data-reveal].is-visible .tkw-bar > i { animation: none; width: var(--bw,100%); }
      [data-reveal].is-visible .wo-cmp > i { animation: none; width: var(--bw,100%); }
      .tkw-arc, .tkw-draw { stroke-dashoffset: 0 !important; animation: none !important; }
      .tkw-pop { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>

<main id="top">

    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-6 pb-16 lg:pt-8 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-blob" aria-hidden="true" style="top:-6rem;right:-4rem;width:26rem;height:26rem;"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 lg:px-8">
        <!-- breadcrumb -->
        <nav data-reveal class="mb-8 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/#top" class="transition hover:text-primary">Home</a>
          <i class="ph-bold ph-caret-right text-xs"></i>
          <span class="text-foreground">Website Optimization</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-primary shadow-sm"><i class="ph-fill ph-magic-wand"></i> Speed · Technical SEO · AI-ready</span>
            <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl">
              Same website.<br class="hidden sm:block" /> <span class="text-primary">Faster, cleaner,</span> and ready for AI search.
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
              We tune your existing site from the source code up — <b class="font-semibold text-foreground">speed, Core Web Vitals, technical &amp; on-page SEO, and AI-readiness (GEO)</b>. Measured before and after, your source backed up, and the optimized site deployed for you.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#plans" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:-translate-y-px hover:bg-primary/90 active:scale-[0.98]">
                See plans &amp; pricing <i class="ph-bold ph-arrow-down"></i>
              </a>
              <a href="#contact" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">
                Get a free audit
              </a>
            </div>
            <div class="mt-7 flex flex-wrap gap-2.5">
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-magnifying-glass text-sm"></i></span> Free audit on every plan</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-floppy-disk text-sm"></i></span> Source backed up first</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-rocket-launch text-sm"></i></span> We deploy it for you</span>
            </div>

            <!-- SAMPLE FIGURES: replace with real numbers -->
            <div data-reveal class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl border border-border bg-card/70 p-3 pr-5 shadow-sm backdrop-blur">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-2.5">
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-xs font-bold text-white ring-2 ring-card">M</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 text-xs font-bold text-white ring-2 ring-card">H</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-violet-400 to-violet-600 text-xs font-bold text-white ring-2 ring-card">T</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-primary text-[10px] font-bold text-primary-foreground ring-2 ring-card">+1k</span>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex text-amber-400"><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i></span>
                    <span class="text-sm font-bold text-foreground">4.9/5</span>
                  </div>
                  <p class="text-xs text-muted-foreground"><b class="font-bold text-foreground"><span data-count="1200">0</span>+</b> sites optimized</p>
                </div>
              </div>
              <span class="hidden h-10 w-px bg-border sm:block"></span>
