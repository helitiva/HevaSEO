---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Keyword Research & SEO Strategy | HevaSEO"
  description="HevaSEO's keyword research & SEO strategy service: a keyword map by intent, topic clusters (topical map), competitor analysis, and a content roadmap. 3 plans: Basic, Advanced, Comprehensive."
  keywords="keyword research, seo strategy, topical map, content cluster, search intent, keyword gap, seo roadmap"
  ogDescription="A keyword map by intent, topic clusters, and a content roadmap — know exactly what to write, where to link, and in what order."
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "Keyword Research & SEO Strategy",
        "serviceType": "Keyword research & SEO strategy",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "A keyword map by intent, topic clusters (topical map), competitor analysis, and a content roadmap that show businesses exactly what to write and where to link.",
        "offers": [
          { "@type": "Offer", "name": "Basic", "price": "20", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Advanced", "price": "40", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Comprehensive", "price": "79", "priceCurrency": "USD" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Keyword Research & SEO Strategy", "item": "https://hevaseo.com/keyword-strategy" }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* ---- decorative background layers ---- */
    .kw-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .kw-dots-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image: radial-gradient(hsl(var(--primary) / 0.22) 1.4px, transparent 1.4px);
      background-size: 24px 24px;
      -webkit-mask-image: radial-gradient(circle at 85% 25%, #000, transparent 60%);
      mask-image: radial-gradient(circle at 85% 25%, #000, transparent 60%);
      opacity: 0.6;
    }
    .kw-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    /* ---- scroll-reveal stagger (reuses base [data-reveal] transition) ---- */
    .kw-stagger > [data-reveal]:nth-child(2) { transition-delay: 0.07s; }
    .kw-stagger > [data-reveal]:nth-child(3) { transition-delay: 0.14s; }
    .kw-stagger > [data-reveal]:nth-child(4) { transition-delay: 0.21s; }
    .kw-stagger > [data-reveal]:nth-child(5) { transition-delay: 0.28s; }
    .kw-stagger > [data-reveal]:nth-child(6) { transition-delay: 0.35s; }

    /* ---- card: lift + icon spring + top sheen on hover (feedback) ---- */
    .kw-card { position: relative; transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), box-shadow 0.4s ease, border-color 0.4s ease; }
    .kw-card:hover { transform: translateY(-5px); border-color: hsl(var(--primary) / 0.45); box-shadow: 0 20px 45px hsl(var(--primary) / 0.13); }
    .kw-card::after {
      content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
      opacity: 0; transition: opacity 0.4s ease;
      background: radial-gradient(130% 80% at 50% 0%, hsl(var(--primary) / 0.10), transparent 58%);
    }
    .kw-card:hover::after { opacity: 1; }
    .kw-ic { transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1); }
    .kw-card:hover .kw-ic { transform: scale(1.12) rotate(-5deg); }

    /* ============ PROCESS — bespoke mini-graphic per step ============ */
    .proc-art {
      position: relative; height: 116px; overflow: hidden;
      border-radius: 14px; border: 1px solid hsl(var(--border));
      background: hsl(var(--muted) / 0.5); padding: 0.8rem;
    }
    .dark .proc-art { background: hsl(var(--background) / 0.6); }
    @keyframes pa-grow { to { transform: scaleX(1); } }
    @keyframes pa-rise { to { transform: scaleY(1); } }
    @keyframes pa-pop  { to { opacity: 1; transform: translateX(-50%) scale(1); } }
    @keyframes pa-draw { to { stroke-dashoffset: 0; } }

    /* 01 — scan rows (collecting keywords + volume + KD) */
    .pa-rows { display: flex; flex-direction: column; gap: 0.46rem; }
    .pa-row { display: flex; align-items: center; gap: 0.4rem; }
    .pa-kw { width: 5.2rem; font-size: 0.62rem; font-weight: 600; color: hsl(var(--foreground)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pa-vol { flex: 1; height: 0.34rem; border-radius: 9999px; background: hsl(var(--border)); position: relative; overflow: hidden; }
    .pa-vol::before { content: ""; position: absolute; inset: 0; width: var(--w, 60%); border-radius: inherit; background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--primary) / 0.5)); transform: scaleX(0); transform-origin: left; }
    [data-reveal].is-visible .pa-vol::before { animation: pa-grow 0.7s cubic-bezier(0.16,1,0.3,1) forwards; }
    [data-reveal].is-visible .pa-row:nth-child(2) .pa-vol::before { animation-delay: 0.12s; }
    [data-reveal].is-visible .pa-row:nth-child(3) .pa-vol::before { animation-delay: 0.24s; }
    .pa-kd { font-family: ui-monospace, monospace; font-size: 0.55rem; font-weight: 700; padding: 0.05rem 0.32rem; border-radius: 5px; background: hsl(var(--primary) / 0.12); color: hsl(var(--primary)); }
    .pa-kd.ok { background: hsl(152 55% 45% / 0.16); color: hsl(152 52% 40%); }

    /* 02 — intent buckets (3 columns) */
    .pa-intent { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.55rem; align-items: end; height: 100%; }
    .pa-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 0.28rem; height: 100%; }
    .pa-bar { width: 100%; border-radius: 7px 7px 4px 4px; transform: scaleY(0); transform-origin: bottom; }
    .pa-bar.b-info { height: 80%; background: linear-gradient(hsl(214 90% 60%), hsl(214 90% 60% / 0.45)); }
    .pa-bar.b-comm { height: 56%; background: linear-gradient(hsl(38 92% 55%), hsl(38 92% 55% / 0.45)); }
    .pa-bar.b-tran { height: 40%; background: linear-gradient(hsl(152 60% 45%), hsl(152 60% 45% / 0.45)); }
    [data-reveal].is-visible .pa-bar { animation: pa-rise 0.7s cubic-bezier(0.34,1.4,0.6,1) forwards; }
    [data-reveal].is-visible .pa-col:nth-child(2) .pa-bar { animation-delay: 0.1s; }
    [data-reveal].is-visible .pa-col:nth-child(3) .pa-bar { animation-delay: 0.2s; }
    .pa-tag { font-size: 0.56rem; font-weight: 700; color: hsl(var(--muted-foreground)); }

    /* 03 — topical map (pillar + cluster nodes) */
    .pa-map-lines { position: absolute; inset: 8px 10px; width: calc(100% - 20px); height: calc(100% - 16px); overflow: visible; }
    .pa-map-lines path { fill: none; stroke: hsl(var(--primary) / 0.5); stroke-width: 1.6; stroke-dasharray: 130; stroke-dashoffset: 130; }
    [data-reveal].is-visible .pa-map-lines path { animation: pa-draw 0.8s ease forwards 0.15s; }
    [data-reveal].is-visible .pa-map-lines path:nth-child(2) { animation-delay: 0.28s; }
    [data-reveal].is-visible .pa-map-lines path:nth-child(3) { animation-delay: 0.41s; }
    .pa-node { position: absolute; transform: translateX(-50%) scale(0.6); opacity: 0; font-size: 0.55rem; font-weight: 700; white-space: nowrap; padding: 0.13rem 0.42rem; border-radius: 6px; background: hsl(var(--card)); border: 1px solid hsl(var(--border)); color: hsl(var(--foreground)); }
    .pa-node.pillar { background: hsl(var(--primary)); border-color: transparent; color: hsl(var(--primary-foreground)); box-shadow: 0 4px 12px hsl(var(--primary) / 0.3); }
    [data-reveal].is-visible .pa-node { animation: pa-pop 0.45s cubic-bezier(0.34,1.56,0.64,1) forwards; }
    [data-reveal].is-visible .pa-node:nth-child(3) { animation-delay: 0.3s; }
    [data-reveal].is-visible .pa-node:nth-child(4) { animation-delay: 0.4s; }
    [data-reveal].is-visible .pa-node:nth-child(5) { animation-delay: 0.5s; }

    /* 04 — prioritized roadmap rows */
    .proc-road { display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; height: 100%; }
    .pa-prow { display: flex; align-items: center; gap: 0.45rem; }
    .pa-rank { font-family: ui-monospace, monospace; font-size: 0.55rem; font-weight: 800; padding: 0.1rem 0.34rem; border-radius: 5px; color: hsl(var(--primary-foreground)); background: hsl(var(--primary)); }
    .pa-rank.r2 { background: hsl(var(--primary) / 0.7); }
    .pa-rank.r3 { background: hsl(var(--primary) / 0.45); }
    .pa-task { flex: 1; height: 0.5rem; border-radius: 9999px; background: hsl(var(--border)); overflow: hidden; }
    .pa-task b { display: block; height: 100%; width: var(--w, 60%); border-radius: inherit; background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--primary) / 0.5)); transform: scaleX(0); transform-origin: left; }
    [data-reveal].is-visible .pa-task b { animation: pa-grow 0.7s cubic-bezier(0.16,1,0.3,1) forwards; }
    [data-reveal].is-visible .pa-prow:nth-child(2) .pa-task b { animation-delay: 0.12s; }
    [data-reveal].is-visible .pa-prow:nth-child(3) .pa-task b { animation-delay: 0.24s; }
    .pa-mo { font-size: 0.55rem; font-weight: 700; color: hsl(var(--muted-foreground)); }

    /* ============ DELIVERABLES — mini-graphic per card ============ */
    .dl-art { position: relative; height: 90px; overflow: hidden; border-radius: 12px; border: 1px solid hsl(var(--border)); background: hsl(var(--card)); padding: 0.65rem; }
    .dark .dl-art { background: hsl(var(--background) / 0.45); }

    /* 1 — spreadsheet */
    .dl-sheet { display: flex; flex-direction: column; gap: 4px; height: 100%; }
    .dl-srow { flex: 1; display: grid; grid-template-columns: 1.6fr 1.1fr 0.6fr; gap: 4px; }
    .dl-cell { border-radius: 3px; background: hsl(var(--muted)); }
    .dl-srow.head .dl-cell { background: hsl(var(--primary) / 0.6); }
    .dl-cell.vol { background: hsl(var(--primary) / 0.16); }
    .dl-cell.kd { background: hsl(152 55% 45% / 0.18); }

    /* 2 & 6 — node networks */
    .dl-net { position: absolute; inset: 0; width: 100%; height: 100%; }
    .dl-net line { stroke: hsl(var(--primary) / 0.4); stroke-width: 1.4; stroke-dasharray: 150; stroke-dashoffset: 150; }
    [data-reveal].is-visible .dl-net line { animation: pa-draw 0.7s ease forwards 0.1s; }
    [data-reveal].is-visible .dl-net line:nth-child(2) { animation-delay: 0.18s; }
    [data-reveal].is-visible .dl-net line:nth-child(3) { animation-delay: 0.26s; }
    [data-reveal].is-visible .dl-net line:nth-child(4) { animation-delay: 0.34s; }
    [data-reveal].is-visible .dl-net line:nth-child(5) { animation-delay: 0.42s; }
    .dl-dot { position: absolute; transform: translate(-50%,-50%) scale(0); width: 0.66rem; height: 0.66rem; border-radius: 50%; background: hsl(var(--primary) / 0.55); }
    .dl-dot.hub { width: 1.7rem; height: 1.7rem; display: grid; place-items: center; font-size: 0.56rem; font-weight: 700; color: hsl(var(--primary-foreground)); background: hsl(var(--primary)); box-shadow: 0 3px 11px hsl(var(--primary) / 0.35); }
    .dl-dot.lk { width: 1.45rem; height: 1.45rem; border-radius: 7px; display: grid; place-items: center; font-size: 0.7rem; color: hsl(var(--primary)); background: hsl(var(--primary) / 0.15); border: 1px solid hsl(var(--primary) / 0.3); }
    [data-reveal].is-visible .dl-dot { animation: dl-pop 0.42s cubic-bezier(0.34,1.56,0.64,1) forwards; }
    [data-reveal].is-visible .dl-dot:nth-child(3) { animation-delay: 0.1s; }
    [data-reveal].is-visible .dl-dot:nth-child(4) { animation-delay: 0.18s; }
    [data-reveal].is-visible .dl-dot:nth-child(5) { animation-delay: 0.26s; }
    [data-reveal].is-visible .dl-dot:nth-child(6) { animation-delay: 0.34s; }
    @keyframes dl-pop { to { transform: translate(-50%,-50%) scale(1); } }

    /* 3 — intent donut */
    .dl-pie { display: flex; align-items: center; gap: 0.75rem; height: 100%; }
    .dl-donut { width: 56px; height: 56px; border-radius: 50%; position: relative; flex-shrink: 0; background: conic-gradient(hsl(214 90% 60%) 0 45%, hsl(38 92% 55%) 45% 75%, hsl(152 60% 45%) 75% 100%); }
    .dl-donut::after { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: hsl(var(--card)); }
    .dark .dl-donut::after { background: hsl(var(--background)); }
    .dl-legend { display: flex; flex-direction: column; gap: 0.32rem; font-size: 0.6rem; color: hsl(var(--muted-foreground)); }
    .dl-legend span { display: flex; align-items: center; gap: 0.34rem; }
    .dl-legend i { width: 0.5rem; height: 0.5rem; border-radius: 2px; flex-shrink: 0; }

    /* 4 — competitor gap */
    .dl-vs { display: flex; flex-direction: column; gap: 0.5rem; justify-content: center; height: 100%; }
    .dl-vrow { display: flex; align-items: center; gap: 0.45rem; }
    .dl-vlabel { width: 3rem; font-size: 0.6rem; font-weight: 700; color: hsl(var(--muted-foreground)); }
    .dl-vtrack { flex: 1; display: flex; height: 0.5rem; border-radius: 9999px; background: hsl(var(--border)); overflow: hidden; }
    .dl-vseg { height: 100%; transform: scaleX(0); transform-origin: left; }
    .dl-vseg.me { background: hsl(var(--primary)); border-radius: 9999px; }
    .dl-vseg.comp { background: hsl(var(--muted-foreground) / 0.4); }
    .dl-vseg.gap { background: repeating-linear-gradient(45deg, hsl(var(--primary) / 0.55), hsl(var(--primary) / 0.55) 3px, transparent 3px, transparent 6px); }
    [data-reveal].is-visible .dl-vseg { animation: pa-grow 0.7s cubic-bezier(0.16,1,0.3,1) forwards; }
    [data-reveal].is-visible .dl-vrow:nth-child(2) .dl-vseg { animation-delay: 0.12s; }
    .dl-gaptag { display: inline-flex; align-items: center; gap: 0.25rem; align-self: flex-start; font-size: 0.55rem; font-weight: 700; color: hsl(var(--primary)); }

    /* 5 — roadmap months */
    .dl-months { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.4rem; align-items: end; height: 100%; }
    .dl-mcol { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 0.22rem; height: 100%; }
    .dl-mbar { width: 100%; border-radius: 4px 4px 2px 2px; background: linear-gradient(hsl(var(--primary)), hsl(var(--primary) / 0.45)); transform: scaleY(0); transform-origin: bottom; }
    [data-reveal].is-visible .dl-mbar { animation: pa-rise 0.6s cubic-bezier(0.34,1.4,0.6,1) forwards; }
    [data-reveal].is-visible .dl-mcol:nth-child(2) .dl-mbar { animation-delay: 0.06s; }
    [data-reveal].is-visible .dl-mcol:nth-child(3) .dl-mbar { animation-delay: 0.12s; }
    [data-reveal].is-visible .dl-mcol:nth-child(4) .dl-mbar { animation-delay: 0.18s; }
    [data-reveal].is-visible .dl-mcol:nth-child(5) .dl-mbar { animation-delay: 0.24s; }
    [data-reveal].is-visible .dl-mcol:nth-child(6) .dl-mbar { animation-delay: 0.3s; }
    .dl-mlabel { font-size: 0.5rem; font-weight: 700; color: hsl(var(--muted-foreground)); }

    .kw-step-num { transition: color 0.4s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1); }
    .kw-card:hover .kw-step-num { color: hsl(var(--primary) / 0.45); transform: translateY(-2px); }

    /* ---- shimmer sweep on the "popular" badge (hierarchy cue) ---- */
    .kw-shine { position: relative; overflow: hidden; }
    .kw-shine::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(110deg, transparent 32%, hsl(0 0% 100% / 0.55) 50%, transparent 68%);
      transform: translateX(-130%);
      animation: kw-sweep 3.4s ease-in-out infinite;
    }
    @keyframes kw-sweep { 0% { transform: translateX(-130%); } 55%, 100% { transform: translateX(240%); } }

    /* ---- comparison table: check marks pop in on reveal ---- */
    .kw-table.is-visible .ph-check { animation: kw-check-pop 0.45s cubic-bezier(0.34,1.56,0.64,1) both; }
    .kw-table.is-visible tbody tr:nth-child(2) .ph-check { animation-delay: 0.06s; }
    .kw-table.is-visible tbody tr:nth-child(3) .ph-check { animation-delay: 0.12s; }
    .kw-table.is-visible tbody tr:nth-child(4) .ph-check { animation-delay: 0.18s; }
    .kw-table.is-visible tbody tr:nth-child(5) .ph-check { animation-delay: 0.24s; }
    .kw-table.is-visible tbody tr:nth-child(6) .ph-check { animation-delay: 0.30s; }
    @keyframes kw-check-pop { 0% { opacity: 0; transform: scale(0.4); } 100% { opacity: 1; transform: scale(1); } }

    /* ---- gentle idle float for the price tier icons ---- */
    .kw-float { animation: kw-bob 4.5s ease-in-out infinite; }
    @keyframes kw-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

    /* ---- pulsing ring on the primary CTA (draws the eye) ---- */
    .kw-pulse { position: relative; }
    .kw-pulse::before {
      content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: -1;
      box-shadow: 0 0 0 0 hsl(var(--primary) / 0.45);
      animation: kw-cta-ping 2.6s cubic-bezier(0.4,0,0.2,1) infinite;
    }
    @keyframes kw-cta-ping { 0% { box-shadow: 0 0 0 0 hsl(var(--primary) / 0.4); } 70%, 100% { box-shadow: 0 0 0 14px hsl(var(--primary) / 0); } }

    /* ---- accessibility: collapse looping/heavy motion ---- */
    @media (prefers-reduced-motion: reduce) {
      .kw-shine::after, .kw-float, .kw-pulse::before { animation: none !important; }
      .pa-vol::before, .pa-task b { transform: scaleX(1); }
      .pa-bar { transform: scaleY(1); }
      .pa-node { opacity: 1; transform: translateX(-50%) scale(1); }
      .pa-map-lines path, .dl-net line { stroke-dashoffset: 0; }
      .dl-dot { transform: translate(-50%,-50%) scale(1); }
      .dl-vseg, .dl-mbar { transform: none; }
      .kw-card:hover { transform: none; }
      .kw-card:hover .kw-ic { transform: none; }
    }
  </style>

<main id="top">

    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-8 pb-16 lg:pt-12 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="kw-grid-bg" aria-hidden="true"></div>
      <div class="kw-blob" aria-hidden="true" style="top:-6rem;right:-4rem;width:26rem;height:26rem;"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
              <i class="ph-fill ph-target"></i> The foundation for every SEO campaign
            </span>
            <h1 class="mt-5 font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl">
              Don't burn your budget<br class="hidden sm:block" /> on <span class="text-primary">the wrong keywords</span>.
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
              A keyword map by intent, topic clusters, and a content roadmap — you'll know exactly <b class="font-semibold text-foreground">what to write, where to link, and in what order</b> before spending a dollar on content or backlinks.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#cac-goi" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:-translate-y-px hover:bg-primary/90 active:scale-[0.98]">
                View 3 plans <i class="ph-bold ph-arrow-down"></i>
              </a>
              <a href="#lienhe" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">
                Get a free consultation
              </a>
            </div>
            <!-- deliverable chips -->
            <div class="mt-7 flex flex-wrap items-center gap-2.5 text-sm">
              <span class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/[0.07] px-3.5 py-1.5 font-medium text-foreground shadow-sm shadow-primary/5"><i class="ph-fill ph-cursor-click text-primary"></i> Interactive web report</span>
              <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 font-medium text-foreground shadow-sm"><i class="ph-fill ph-table text-emerald-500"></i> File Google Sheet</span>
              <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 font-medium text-foreground shadow-sm"><i class="ph-fill ph-gift text-primary"></i> Free Basic plan included</span>
            </div>
            <!-- offer promo bar -->
            <div class="mt-6 overflow-hidden rounded-2xl border border-primary/25 bg-gradient-to-r from-primary/[0.10] via-primary/[0.05] to-transparent shadow-sm shadow-primary/5">
              <div class="flex flex-col divide-y divide-primary/15 sm:flex-row sm:divide-x sm:divide-y-0">
                <div class="flex items-center gap-3 px-4 py-3.5">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-primary text-primary-foreground shadow-sm shadow-primary/30"><i class="ph-fill ph-gift text-lg"></i></span>
                  <div class="leading-tight">
                    <p class="text-sm font-bold tracking-tight text-foreground">20% off</p>
                    <p class="text-xs text-muted-foreground">on your first order</p>
