---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="SEO Web Design — Rank Sustainably | HevaSEO"
  description="HevaSEO's SEO web design service: fast loads, green Core Web Vitals, clean on-page, mobile-first responsive, schema, and Search Console integration. 5 website types from $79 — landing, statistic, blog, e-commerce, webapp."
  keywords="seo web design, seo-friendly web design, seo website design service, seo-ready website, build seo website, landing page design"
  ogDescription="A website that loads fast, hits Core Web Vitals, is on-page clean, and ready to rank on Google. 5 website types from $79."
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "SEO-ready web design",
        "serviceType": "SEO-friendly web design",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "SEO-ready web design: speed optimization, Core Web Vitals, clean on-page, mobile-first responsive, schema markup, and Google Search Console integration.",
        "offers": [
          { "@type": "Offer", "name": "Landing page", "price": "79", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Statistic web", "price": "119", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Blog", "price": "159", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "E-commerce", "price": "279", "priceCurrency": "USD" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "SEO Web Design", "item": "https://hevaseo.com/seo-web-design" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "How is an SEO-ready site different from a regular one?", "acceptedAnswer": { "@type": "Answer", "text": "An SEO-ready site is optimized from the source code up: fast loads, green Core Web Vitals, a sensible heading and URL structure, schema markup, and readiness for Google to crawl and index. A regular site usually only focuses on appearance." } },
          { "@type": "Question", "name": "How long does SEO web design take?", "acceptedAnswer": { "@type": "Answer", "text": "We send a draft in about 2 days. Full delivery: a landing page ~1 week, a statistic or blog site 1–2 weeks, an e-commerce site 3–4 weeks; webapps are quoted by scope." } },
          { "@type": "Question", "name": "Will the site rank on Google right after it's built?", "acceptedAnswer": { "@type": "Answer", "text": "SEO-ready design builds a strong technical foundation that makes ranking easier. However, rankings also depend on content and backlinks — that's the SEO work that comes after the site is finished." } },
          { "@type": "Question", "name": "Does the price include domain and hosting?", "acceptedAnswer": { "@type": "Answer", "text": "The design price covers building the website. Domain and hosting are billed separately by the provider; HevaSEO advises and sets them up for free." } }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* ===== Page flourishes — SEO web design ===== */
    /* shared hero background (synced across service pages) */
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .hero-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    @property --tkwv { syntax: '<number>'; inherits: false; initial-value: 0; }

    /* animated score gauges (conic ring fills on reveal) */
    .tkw-gauge { position: relative; width: 84px; height: 84px; border-radius: 50%;
      display: grid; place-items: center; --tkwv: 0;
      background: conic-gradient(var(--gc, hsl(var(--primary))) calc(var(--tkwv) * 1%), hsl(var(--muted)) 0); }
    .tkw-gauge::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: hsl(var(--card)); }
    .tkw-gauge b { position: relative; font-family: '"Inter Tight"', Inter, sans-serif; font-weight: 700; font-size: 1.3rem; line-height: 1; }
    [data-reveal].is-visible .tkw-gauge { transition: --tkwv 1.5s cubic-bezier(.16,1,.3,1); transition-delay: var(--gd, .2s); --tkwv: var(--to, 0); }

    /* animated metric bars */
    .tkw-bar { position: relative; height: 6px; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
    .tkw-bar > i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #22c55e, #16a34a); }
    [data-reveal].is-visible .tkw-bar > i { animation: tkwBar 1.4s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--bd, .3s); }
    @keyframes tkwBar { to { width: var(--bw, 100%); } }

    /* scanning sheen across the scorecard */
    .tkw-scan { position: relative; overflow: hidden; }
    .tkw-scan::after { content: ""; position: absolute; left: 0; right: 0; top: -42%; height: 36%; pointer-events: none; z-index: 5;
      background: linear-gradient(180deg, hsl(var(--primary) / .16), transparent);
      animation: tkwScan 3.6s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes tkwScan { 0% { transform: translateY(0); } 100% { transform: translateY(380%); } }

    /* floating glass chips around hero card */
    .tkw-chip { position: absolute; z-index: 30; display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; border: 1px solid hsl(var(--border)); background: hsl(var(--card) / .92);
      padding: .45rem .8rem; font-size: .78rem; font-weight: 600; white-space: nowrap;
      box-shadow: 0 10px 28px hsl(213 50% 20% / .14); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      animation: tkwFloat 6s ease-in-out infinite; }
    .dark .tkw-chip { box-shadow: 0 10px 28px hsl(0 0% 0% / .4); }
    .tkw-chip.d2 { animation-duration: 7.4s; animation-delay: -2.2s; }
    .tkw-chip.d3 { animation-duration: 8.6s; animation-delay: -4.1s; }
    @keyframes tkwFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-11px); } }

    /* card hover lift + icon pop */
    .tkw-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .tkw-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .tkw-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }
    .tkw-ic { transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
    .tkw-card:hover .tkw-ic, .tkw-step:hover .tkw-ic { transform: scale(1.14) rotate(-7deg); }

    /* feature-card graphics */
    .tkw-figure { position: relative; height: 10.5rem; overflow: hidden;
      background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .14), transparent 58%),
        radial-gradient(hsl(var(--primary) / .13) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .2), transparent 58%),
        radial-gradient(hsl(var(--primary) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure svg { position: relative; transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .tkw-card:hover .tkw-figure svg { transform: scale(1.04); }
    .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(213 50% 25% / .15)); }
    .dark .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(0 0% 0% / .5)); }
    .tkw-figure .glow { filter: drop-shadow(0 0 5px hsl(var(--primary) / .5)); }
    /* hero guarantee pills */
    .tkw-guar { transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s ease; }
    .tkw-guar:hover { transform: translateY(-2px); box-shadow: 0 10px 24px hsl(213 60% 30% / .18); }
    /* warning (pain-point) variant — red tint */
    .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .13), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .12) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .22), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure .glow-warn { filter: drop-shadow(0 0 5px hsl(var(--destructive) / .45)); }
    .tkw-arc { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-arc { animation: tkwArc 1.5s cubic-bezier(.16,1,.3,1) .2s forwards; }
    @keyframes tkwArc { to { stroke-dashoffset: var(--arc, 10); } }
    .tkw-draw { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-draw { animation: tkwDraw 1.6s cubic-bezier(.16,1,.3,1) .25s forwards; }
    @keyframes tkwDraw { to { stroke-dashoffset: 0; } }
    .tkw-pop { opacity: 0; transform: scale(.5); transform-box: fill-box; transform-origin: center; }
    [data-reveal].is-visible .tkw-pop { animation: tkwPop .55s cubic-bezier(.34,1.56,.64,1) forwards; }
    .tkw-pop.p1 { animation-delay: .25s; } .tkw-pop.p2 { animation-delay: .4s; }
    .tkw-pop.p3 { animation-delay: .55s; } .tkw-pop.p4 { animation-delay: .7s; } .tkw-pop.p5 { animation-delay: .85s; }
    @keyframes tkwPop { to { opacity: 1; transform: scale(1); } }

    /* staggered reveal inside grids */
    .tkw-grid > [data-reveal]:nth-child(2) { transition-delay: .07s; }
    .tkw-grid > [data-reveal]:nth-child(3) { transition-delay: .14s; }
    .tkw-grid > [data-reveal]:nth-child(4) { transition-delay: .21s; }
    .tkw-grid > [data-reveal]:nth-child(5) { transition-delay: .28s; }
    .tkw-grid > [data-reveal]:nth-child(6) { transition-delay: .35s; }

    /* gradient number */
    .tkw-num { background: linear-gradient(135deg, hsl(var(--primary)), hsl(199 95% 62%)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    /* shimmer sweep on featured badge */
    .tkw-shine { position: relative; overflow: hidden; }
    .tkw-shine::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 30%, hsl(0 0% 100% / .55) 50%, transparent 70%);
      transform: translateX(-130%); animation: tkwShine 3.4s ease-in-out infinite; }
    @keyframes tkwShine { 0%, 55% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }

    /* pulsing live ring */
    .tkw-live { position: relative; }
    .tkw-live::before { content: ""; position: absolute; inset: -5px; border-radius: 999px; border: 2px solid hsl(142 70% 45% / .6); animation: tkwPing 1.8s ease-out infinite; }
    @keyframes tkwPing { 0% { transform: scale(.5); opacity: .9; } 100% { transform: scale(1.9); opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
      .tkw-scan::after, .tkw-chip, .tkw-shine::after, .tkw-live::before { animation: none !important; }
      .tkw-chip { transform: none !important; }
      [data-reveal].is-visible .tkw-gauge { transition: none; --tkwv: var(--to,0); }
      [data-reveal].is-visible .tkw-bar > i { animation: none; width: var(--bw,100%); }
      .tkw-arc, .tkw-draw { stroke-dashoffset: 0 !important; animation: none !important; }
      .tkw-pop { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>

<main id="top">

    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-6 pb-16 lg:pt-8 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-blob" aria-hidden="true" style="top:-6rem;right:-4rem;width:26rem;height:26rem;"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 lg:px-8">
        <!-- breadcrumb -->
        <nav data-reveal class="mb-8 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/#top" class="transition hover:text-primary">Home</a>
          <i class="ph-bold ph-caret-right text-xs"></i>
          <span class="text-foreground">SEO Web Design</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div data-reveal>
            <h1 class="font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl">
              Beautiful websites are everywhere,<br class="hidden sm:block" /> web <span class="text-primary">ranking</span> is the rare part.
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
              Not just beautiful — your website is optimized from the source code up: <b class="font-semibold text-foreground">fast loads, green Core Web Vitals, clean on-page</b> and ready for Google to crawl and rank. A solid foundation for your SEO campaign to take off.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#plans" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:-translate-y-px hover:bg-primary/90 active:scale-[0.98]">
                View website types <i class="ph-bold ph-arrow-down"></i>
              </a>
              <a href="#contact" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">
                Get a free consultation
              </a>
            </div>
            <div class="mt-7 flex flex-wrap gap-2.5">
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-shield-check text-sm"></i></span> 12-month warranty</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-headset text-sm"></i></span> 24/7 support</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-clock-countdown text-sm"></i></span> On time or your money back</span>
              <span class="tkw-guar inline-flex items-center gap-2 rounded-full border border-border bg-card py-1.5 pl-1.5 pr-4 text-sm font-bold text-foreground shadow-md shadow-primary/10"><span class="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"><i class="ph-fill ph-seal-percent text-sm"></i></span> 10% off your next order</span>
            </div>

            <!-- SAMPLE FIGURES: replace with real numbers -->
            <div data-reveal class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl border border-border bg-card/70 p-3 pr-5 shadow-sm backdrop-blur">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-2.5">
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-xs font-bold text-white ring-2 ring-card">M</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 text-xs font-bold text-white ring-2 ring-card">H</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-violet-400 to-violet-600 text-xs font-bold text-white ring-2 ring-card">T</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-amber-400 to-orange-500 text-xs font-bold text-white ring-2 ring-card">L</span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-primary text-[10px] font-bold text-primary-foreground ring-2 ring-card">+1k</span>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex text-amber-400"><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i><i class="ph-fill ph-star text-sm"></i></span>
                    <span class="text-sm font-bold text-foreground">4.9/5</span>
                  </div>
                  <p class="text-xs text-muted-foreground"><b class="font-bold text-foreground"><span data-count="1200">0</span>+</b> customers have ordered</p>
                </div>
              </div>
              <span class="hidden h-10 w-px bg-border sm:block"></span>
              <div class="flex items-center gap-5">
                <div><p class="font-display text-xl font-bold text-primary"><span data-count="500">0</span>+</p><p class="text-[11px] text-muted-foreground">Projects delivered</p></div>
                <div><p class="font-display text-xl font-bold text-primary"><span data-count="98">0</span>%</p><p class="text-[11px] text-muted-foreground">On time</p></div>
              </div>
            </div>
          </div>

          <!-- hero visual: animated PageSpeed / SEO scorecard -->
          <div data-reveal class="relative">
            <!-- floating glass chips -->
            <span class="tkw-chip -left-3 top-6 text-primary"><i class="ph-fill ph-gauge"></i> Speed 90+</span>
            <span class="tkw-chip d2 -right-2 top-1/3 text-emerald-500"><i class="ph-fill ph-device-mobile"></i> Mobile-first</span>
            <span class="tkw-chip d3 -left-2 bottom-8 text-violet-500"><i class="ph-fill ph-code"></i> Schema ✓</span>

            <div class="rounded-2xl border border-border bg-card p-6 shadow-xl shadow-primary/5 lg:p-7">
              <div class="flex items-center gap-2 pb-4">
                <span class="flex gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-red-400"></i><i class="h-2.5 w-2.5 rounded-full bg-amber-400"></i><i class="h-2.5 w-2.5 rounded-full bg-green-400"></i></span>
                <span class="ml-1 inline-flex items-center gap-1.5 rounded-md bg-muted px-2.5 py-1 text-xs text-muted-foreground"><i class="ph-bold ph-lock-simple"></i> www.your-website.com</span>
                <span class="ml-auto inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-500"><span class="tkw-live grid h-2 w-2 place-items-center rounded-full bg-emerald-500"></span> Live</span>
              </div>
              <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Speed &amp; SEO report</p>

              <div class="mt-5 grid grid-cols-4 gap-2 text-center">
                <div><div class="tkw-gauge mx-auto" style="--to:98;--gc:#22c55e;--gd:.15s"><b class="text-green-500"><span data-count="98" data-decimals="0">0</span></b></div><p class="mt-2 text-[10px] text-muted-foreground">Speed</p></div>
                <div><div class="tkw-gauge mx-auto" style="--to:100;--gc:#22c55e;--gd:.3s"><b class="text-green-500"><span data-count="100">0</span></b></div><p class="mt-2 text-[10px] text-muted-foreground">SEO</p></div>
                <div><div class="tkw-gauge mx-auto" style="--to:96;--gc:#22c55e;--gd:.45s"><b class="text-green-500"><span data-count="96">0</span></b></div><p class="mt-2 text-[10px] text-muted-foreground">A11y</p></div>
                <div><div class="tkw-gauge mx-auto" style="--to:100;--gc:#22c55e;--gd:.6s"><b class="text-green-500"><span data-count="100">0</span></b></div><p class="mt-2 text-[10px] text-muted-foreground">Best</p></div>
              </div>

              <div class="mt-6 space-y-3 text-sm">
                <div>
                  <div class="flex items-center justify-between"><span class="text-muted-foreground">LCP — Largest Contentful Paint</span><span class="font-medium text-green-500">1.2s</span></div>
                  <div class="tkw-bar mt-1.5" style="--bw:92%;--bd:.4s"><i></i></div>
                </div>
                <div>
                  <div class="flex items-center justify-between"><span class="text-muted-foreground">CLS — Layout stability</span><span class="font-medium text-green-500">0.02</span></div>
                  <div class="tkw-bar mt-1.5" style="--bw:97%;--bd:.55s"><i></i></div>
                </div>
                <div>
                  <div class="flex items-center justify-between"><span class="text-muted-foreground">Mobile-friendly</span><span class="font-medium text-green-500">Pass</span></div>
                  <div class="tkw-bar mt-1.5" style="--bw:100%;--bd:.7s"><i></i></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PAIN POINTS ============ -->
    <section class="border-y border-border bg-muted/40 py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div data-reveal class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Sound familiar?</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">A beautiful site that still doesn't bring customers</h2>
          <p class="mt-3 text-muted-foreground">Most websites fail not because they're ugly, but because they skip the technical foundation that makes Google struggle to read them and visitors leave.</p>
        </div>
        <div class="tkw-grid mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

          <!-- 1. Slow loading -->
          <article data-reveal class="tkw-card flex flex-col overflow-hidden rounded-2xl border border-border bg-card">
            <div class="tkw-figure warn flex items-center justify-center border-b border-border" style="height:9rem">
              <svg viewBox="0 0 240 140" class="h-28" role="img" aria-label="Low speed gauge">
                <defs><linearGradient id="slowArc" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#dc2626"/><stop offset="1" stop-color="#f87171"/></linearGradient></defs>
