---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingGrid from '../components/PricingGrid.astro';

const IDX_BADGE = 'Indexer included';

const entityTiers = [
  { name: 'Entity 300', subtitle: '300 links', icon: 'ph-buildings', hue: 'sky', price: '$52', strike: '$130', delivery: '7–10 days', footerBadge: IDX_BADGE, cta: 'Choose Entity 300', goi: 'Entity 300 · $52', features: ['300 authority links', 'Business profile links', 'NAP citations (name · address · phone)', 'Social profile citations', 'Safe, diversified anchors', '80–95% indexed · live per-link report'] },
  { name: 'Entity 500', subtitle: '500 links', icon: 'ph-buildings', hue: 'sky', price: '$79', strike: '$197', delivery: '10–14 days', popular: true, footerBadge: IDX_BADGE, cta: 'Choose Entity 500', goi: 'Entity 500 · $79', features: ['500 authority links', 'Profiles · NAP · social citations', '<b class="font-semibold text-foreground">Trusted directory</b> listings', 'Diversified anchor profile', 'White-hat, Google-safe placements', '80–95% indexed · live per-link report'] },
  { name: 'Entity 1000', subtitle: '1000 links', icon: 'ph-buildings', hue: 'sky', price: '$139', strike: '$347', delivery: '14–21 days', footerBadge: IDX_BADGE, cta: 'Choose Entity 1000', goi: 'Entity 1000 · $139', features: ['1,000 authority links', 'Profiles · NAP · social · directory', '<b class="font-semibold text-foreground">Web 2.0 / extended entity</b> links', 'Widest brand footprint', 'Natural, diversified anchors', '80–95% indexed · live per-link report'] },
];

const pyramidTiers = [
  { name: 'Pyramid Starter', subtitle: 'Tier-1 → Tier-2', icon: 'ph-stack', hue: 'violet', price: '$36', strike: '$90', delivery: '10 days', footerBadge: IDX_BADGE, cta: 'Choose', goi: 'Pyramid Starter · $36', features: ['Tier-1 contextual links', 'Tier-2 support layer', 'Power funneled to 1 target URL', 'Safe, white-hat tiers', '~70% indexed · live report'] },
  { name: 'Pyramid Growth', subtitle: 'Denser Tier-1', icon: 'ph-stack', hue: 'violet', price: '$64', strike: '$160', delivery: '14 days', popular: true, footerBadge: IDX_BADGE, cta: 'Choose', goi: 'Pyramid Growth · $64', features: ['<b class="font-semibold text-foreground">Denser Tier-1</b> contextual links', 'Tier-2 support layer', 'Stronger power to your URL', 'Safe anchor distribution', '~70% indexed · live report'] },
  { name: 'Pyramid Power', subtitle: '3 tiers (T1–T3)', icon: 'ph-stack', hue: 'violet', price: '$104', strike: '$260', delivery: '18 days', footerBadge: IDX_BADGE, cta: 'Choose', goi: 'Pyramid Power · $104', features: ['<b class="font-semibold text-foreground">3 tiers</b> (T1 → T2 → T3)', 'Deeper power flow', 'Boost a competitive URL / category', 'Safe, white-hat structure', '~70% indexed · live report'] },
  { name: 'Pyramid Max', subtitle: 'Full 3 tiers', icon: 'ph-stack', hue: 'violet', price: '$159', strike: '$397', delivery: '21 days', footerBadge: IDX_BADGE, cta: 'Choose', goi: 'Pyramid Max · $159', features: ['Full 3 tiers + extra strong links', 'Maximum power funnel', 'For your most competitive targets', '<b class="font-semibold text-foreground">Advanced Indexer</b> push', '~70%+ indexed · live report'] },
];

const guestTiers = [
  { name: 'Guest 3', subtitle: 'DR30+', icon: 'ph-newspaper-clipping', hue: 'amber', price: '$104', strike: '$260', delivery: '2–3 weeks', footerBadge: IDX_BADGE, cta: 'Choose Guest 3', goi: 'Guest 3 (DR30+) · $104', features: ['3 guest posts on DR30+ blogs', 'SEO article written for each', 'Manual outreach + placement', 'Contextual, in-content links', '~100% indexed · live report'] },
  { name: 'Guest 5', subtitle: 'DR40+', icon: 'ph-newspaper-clipping', hue: 'amber', price: '$180', strike: '$450', delivery: '~3 weeks', popular: true, footerBadge: IDX_BADGE, cta: 'Choose Guest 5', goi: 'Guest 5 (DR40+) · $180', features: ['<b class="font-semibold text-foreground">5 guest posts on DR40+ blogs</b>', 'SEO article written for each', 'Manual outreach + placement', 'Higher-authority, real-traffic sites', '~100% indexed · live report'] },
  { name: 'Guest 5 Pro', subtitle: 'DR50+', icon: 'ph-newspaper-clipping', hue: 'amber', price: '$280', strike: '$700', delivery: '3–4 weeks', footerBadge: IDX_BADGE, cta: 'Choose Guest 5 Pro', goi: 'Guest 5 Pro (DR50+) · $280', features: ['5 guest posts on DR50+ blogs', '<b class="font-semibold text-foreground">+ Pyramid boost per post</b>', 'SEO article written for each', 'Premium, high-traffic publications', '~100% indexed · live report'] },
];
---
<BaseLayout
  title="Backlinks — Authority That Lasts, Every Link Indexed | HevaSEO"
  description="White-hat backlinks across the 4 systems Google trusts: Entity, Pyramid, Guest Post and PR. Every package includes our Indexer free — Entity 80–95%, Pyramid ~70%, Guest & PR ~100% indexed in 2 weeks. Live per-link report, dead-link replacement. Plans from $36."
  keywords="backlinks, white hat backlinks, entity backlinks, link pyramid, guest posts, PR backlinks, backlink indexer, link building service, DR40 guest post"
  ogDescription="Safe links that actually count — every backlink package ships with our Indexer free, with a 2-week index-rate guarantee and a live per-link report. From $36."
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "Backlinks",
        "serviceType": "White-hat link building (Entity, Pyramid, Guest Post, PR) with free indexing",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "White-hat backlink building across four systems — Entity, Pyramid, Guest Post and PR. Every package includes our Indexer free, with a 2-week index-rate guarantee, a live per-link report and dead-link replacement.",
        "offers": [
          { "@type": "Offer", "name": "Entity 300", "price": "52", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Entity 500", "price": "79", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Entity 1000", "price": "139", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Pyramid Starter", "price": "36", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Pyramid Growth", "price": "64", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Pyramid Power", "price": "104", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Pyramid Max", "price": "159", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Guest 3 (DR30+)", "price": "104", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Guest 5 (DR40+)", "price": "180", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Guest 5 Pro (DR50+)", "price": "280", "priceCurrency": "USD" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Backlinks", "item": "https://hevaseo.com/backlink" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "Is our Indexer really included free with every backlink package?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every Backlink package — Entity, Pyramid, Guest Post and PR — runs through our Indexer at no extra cost. Typical 2-week index rates: Entity 80–95%, Pyramid ~70%, Guest Post ~100%, PR ~100%. A link Google never indexes can't pass authority, so we index by default." } },
          { "@type": "Question", "name": "Are the links safe / white-hat?", "acceptedAnswer": { "@type": "Answer", "text": "100% white-hat. We follow Google's guidelines, diversify anchors at safe ratios, and build a natural link profile across trusted platforms. No PBNs, no spam, no black-box tactics." } },
          { "@type": "Question", "name": "What DR / DA do the links have?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the package. Entity builds authoritative profile and citation links; Guest Post placements start at DR30+, DR40+ and DR50+; PR lands on international news outlets. Every live link's DR/DA is shown in your report." } },
          { "@type": "Question", "name": "What index rate can I expect?", "acceptedAnswer": { "@type": "Answer", "text": "Within the first two weeks: Entity 80–95%, Pyramid ~70%, Guest Post ~100% and PR ~100%. Your live report shows the exact percentage indexed, updated as links are crawled." } },
          { "@type": "Question", "name": "How long until I see results?", "acceptedAnswer": { "@type": "Answer", "text": "Links are delivered within each package's SLA (from ~10 days to 3–4 weeks). Ranking impact builds over the following weeks as the links index and Google recalculates authority — backlinks compound over time." } },
          { "@type": "Question", "name": "What if a link goes down?", "acceptedAnswer": { "@type": "Answer", "text": "Dead links are replaced for free. We QA every link before delivery and monitor them after — if one drops, we rebuild it at no charge." } },
          { "@type": "Question", "name": "What do I receive?", "acceptedAnswer": { "@type": "Answer", "text": "A live report page plus an Excel sheet listing every link: live URL, target URL, anchor, type, DR/DA, date and status (Live / Indexed / Pending), with a summary of total live links, average DR and percentage indexed. PR delivers the published article links." } }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* ===== Page flourishes — Backlinks ===== */
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .hero-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    @property --tkwv { syntax: '<number>'; inherits: false; initial-value: 0; }

    /* animated score / index gauges */
    .tkw-gauge { position: relative; width: 84px; height: 84px; border-radius: 50%;
      display: grid; place-items: center; --tkwv: 0;
      background: conic-gradient(var(--gc, hsl(var(--primary))) calc(var(--tkwv) * 1%), hsl(var(--muted)) 0); }
    .tkw-gauge::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: hsl(var(--card)); }
    .tkw-gauge b { position: relative; font-family: '"Inter Tight"', Inter, sans-serif; font-weight: 700; font-size: 1.3rem; line-height: 1; }
    [data-reveal].is-visible .tkw-gauge { transition: --tkwv 1.5s cubic-bezier(.16,1,.3,1); transition-delay: var(--gd, .2s); --tkwv: var(--to, 0); }
    .tkw-gauge.sm { width: 70px; height: 70px; }
    .tkw-gauge.sm::before { inset: 5px; }
    .tkw-gauge.sm b { font-size: 1.1rem; }

    /* animated metric bars */
    .tkw-bar { position: relative; height: 6px; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
    .tkw-bar > i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #22c55e, #16a34a); }
    [data-reveal].is-visible .tkw-bar > i { animation: tkwBar 1.4s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--bd, .3s); }
    @keyframes tkwBar { to { width: var(--bw, 100%); } }

    /* scanning sheen across the report card */
    .tkw-scan { position: relative; overflow: hidden; }
    .tkw-scan::after { content: ""; position: absolute; left: 0; right: 0; top: -42%; height: 36%; pointer-events: none; z-index: 5;
      background: linear-gradient(180deg, hsl(var(--primary) / .16), transparent);
      animation: tkwScan 3.6s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes tkwScan { 0% { transform: translateY(0); } 100% { transform: translateY(380%); } }

    /* floating glass chips around hero card */
    .tkw-chip { position: absolute; z-index: 30; display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; border: 1px solid hsl(var(--border)); background: hsl(var(--card) / .92);
      padding: .45rem .8rem; font-size: .78rem; font-weight: 600; white-space: nowrap;
      box-shadow: 0 10px 28px hsl(213 50% 20% / .14); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      animation: tkwFloat 6s ease-in-out infinite; }
    .dark .tkw-chip { box-shadow: 0 10px 28px hsl(0 0% 0% / .4); }
    .tkw-chip.d2 { animation-duration: 7.4s; animation-delay: -2.2s; }
    .tkw-chip.d3 { animation-duration: 8.6s; animation-delay: -4.1s; }
    @keyframes tkwFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-11px); } }

    /* card hover lift + icon pop */
    .tkw-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .tkw-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .tkw-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }
    .tkw-ic { transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
    .tkw-card:hover .tkw-ic, .tkw-step:hover .tkw-ic { transform: scale(1.14) rotate(-7deg); }

    /* feature-card graphics */
    .tkw-figure { position: relative; height: 10.5rem; overflow: hidden;
      background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .14), transparent 58%),
        radial-gradient(hsl(var(--primary) / .13) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--primary) / .2), transparent 58%),
        radial-gradient(hsl(var(--primary) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure svg { position: relative; transition: transform .45s cubic-bezier(.16,1,.3,1); }
    .tkw-card:hover .tkw-figure svg { transform: scale(1.04); }
    .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(213 50% 25% / .15)); }
    .dark .tkw-figure .lift { filter: drop-shadow(0 6px 13px hsl(0 0% 0% / .5)); }
    .tkw-figure .glow { filter: drop-shadow(0 0 5px hsl(var(--primary) / .5)); }
    .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .13), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .12) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .dark .tkw-figure.warn { background:
        radial-gradient(135% 130% at 50% -18%, hsl(var(--destructive) / .22), transparent 58%),
        radial-gradient(hsl(var(--destructive) / .16) 1px, transparent 1.5px);
      background-size: auto, 19px 19px; background-position: center; }
    .tkw-figure .glow-warn { filter: drop-shadow(0 0 5px hsl(var(--destructive) / .45)); }
    .tkw-guar { transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s ease; }
    .tkw-guar:hover { transform: translateY(-2px); box-shadow: 0 10px 24px hsl(213 60% 30% / .18); }
    .tkw-arc { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-arc { animation: tkwArc 1.5s cubic-bezier(.16,1,.3,1) .2s forwards; }
    @keyframes tkwArc { to { stroke-dashoffset: var(--arc, 10); } }
    .tkw-draw { stroke-dasharray: 100; stroke-dashoffset: 100; }
    [data-reveal].is-visible .tkw-draw { animation: tkwDraw 1.6s cubic-bezier(.16,1,.3,1) .25s forwards; }
    @keyframes tkwDraw { to { stroke-dashoffset: 0; } }
    .tkw-pop { opacity: 0; transform: scale(.5); transform-box: fill-box; transform-origin: center; }
    [data-reveal].is-visible .tkw-pop { animation: tkwPop .55s cubic-bezier(.34,1.56,.64,1) forwards; }
    .tkw-pop.p1 { animation-delay: .25s; } .tkw-pop.p2 { animation-delay: .4s; }
    .tkw-pop.p3 { animation-delay: .55s; } .tkw-pop.p4 { animation-delay: .7s; } .tkw-pop.p5 { animation-delay: .85s; }
    @keyframes tkwPop { to { opacity: 1; transform: scale(1); } }

    /* staggered reveal inside grids */
    .tkw-grid > [data-reveal]:nth-child(2) { transition-delay: .07s; }
    .tkw-grid > [data-reveal]:nth-child(3) { transition-delay: .14s; }
    .tkw-grid > [data-reveal]:nth-child(4) { transition-delay: .21s; }
    .tkw-grid > [data-reveal]:nth-child(5) { transition-delay: .28s; }
    .tkw-grid > [data-reveal]:nth-child(6) { transition-delay: .35s; }

    .tkw-num { background: linear-gradient(135deg, hsl(var(--primary)), hsl(199 95% 62%)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    .tkw-shine { position: relative; overflow: hidden; }
    .tkw-shine::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 30%, hsl(0 0% 100% / .55) 50%, transparent 70%);
      transform: translateX(-130%); animation: tkwShine 3.4s ease-in-out infinite; }
    @keyframes tkwShine { 0%, 55% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }

    .tkw-live { position: relative; }
    .tkw-live::before { content: ""; position: absolute; inset: -5px; border-radius: 999px; border: 2px solid hsl(142 70% 45% / .6); animation: tkwPing 1.8s ease-out infinite; }
    @keyframes tkwPing { 0% { transform: scale(.5); opacity: .9; } 100% { transform: scale(1.9); opacity: 0; } }

    /* === backlink-specific === */
    /* "Indexer included" badge — the hallmark, green */
    .bl-idx { display: inline-flex; align-items: center; gap: .4rem;
      border-radius: 999px; padding: .3rem .7rem; font-size: .72rem; font-weight: 700; letter-spacing: .01em;
      background: linear-gradient(120deg, hsl(142 72% 45% / .16), hsl(142 72% 45% / .06));
      color: hsl(142 64% 32%); border: 1px solid hsl(142 64% 42% / .35); }
    .dark .bl-idx { color: hsl(142 70% 62%); border-color: hsl(142 64% 50% / .4); }

    /* link status pills */
    .bl-pill { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px;
      padding: .12rem .5rem; font-size: .66rem; font-weight: 700; white-space: nowrap; }
    .bl-pill.live { background: hsl(142 64% 45% / .14); color: hsl(142 60% 34%); }
    .bl-pill.idx  { background: hsl(var(--primary) / .12); color: hsl(var(--primary)); }
    .bl-pill.pend { background: hsl(38 92% 50% / .15); color: hsl(32 80% 42%); }
    .dark .bl-pill.live { color: hsl(142 65% 60%); } .dark .bl-pill.pend { color: hsl(38 92% 62%); }
    /* DR badge */
    .bl-dr { display: inline-flex; align-items: center; border-radius: 6px; padding: .1rem .4rem;
      font-size: .66rem; font-weight: 800; background: hsl(var(--muted)); color: hsl(var(--foreground)); font-family: '"Inter Tight"', Inter, sans-serif; }

    /* connecting line for the process timeline */
    .bl-flow { position: relative; }
    @media (min-width: 1024px) {
      .bl-flow::before { content: ""; position: absolute; top: 2.25rem; left: 10%; right: 10%; height: 2px; z-index: 0;
        background: repeating-linear-gradient(90deg, hsl(var(--primary) / .45) 0 10px, transparent 10px 20px); }
    }
    .bl-step-card { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .bl-step-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / .45); box-shadow: 0 20px 44px hsl(213 60% 28% / .14); }
    .dark .bl-step-card:hover { box-shadow: 0 20px 44px hsl(0 0% 0% / .45); }

    /* package card hover */
    .bl-pkg { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s ease, border-color .3s ease; }
    .bl-pkg:hover { transform: translateY(-5px); border-color: hsl(var(--primary) / .45); box-shadow: 0 18px 40px hsl(213 60% 28% / .14); }
    .dark .bl-pkg:hover { box-shadow: 0 18px 40px hsl(0 0% 0% / .45); }

    /* === looping decorative motion === */
    @keyframes blPulseRing { 0% { transform: scale(.5); opacity: .6; } 100% { transform: scale(2); opacity: 0; } }
    @keyframes blFloatY { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @keyframes blBlink { 0%,100% { opacity: 1; } 50% { opacity: .18; } }
    @keyframes blDissolve { 0%,100% { opacity: 1; } 48% { opacity: .1; } }
    @keyframes blRiseFade { 0% { transform: translateY(5px); opacity: 0; } 30% { opacity: .85; } 100% { transform: translateY(-13px); opacity: 0; } }
    @keyframes blGlow { 0%,100% { opacity: .18; } 50% { opacity: .8; } }
    @keyframes blShineX { 0% { transform: translateX(-70px); } 55%,100% { transform: translateX(210px); } }
    .bl-pulsering { animation: blPulseRing 2.2s ease-out infinite; transform-box: fill-box; transform-origin: center; }
    .bl-floaty { animation: blFloatY 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .bl-blink { animation: blBlink 1.7s ease-in-out infinite; }
    .bl-dissolve { animation: blDissolve 2.6s ease-in-out infinite; }
    .bl-rise { animation: blRiseFade 2.8s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .bl-glow { animation: blGlow 2.4s ease-in-out infinite; }
    .bl-shine { animation: blShineX 3.6s ease-in-out infinite; }
    .bl-mover { fill: hsl(var(--primary)); }
    .bl-mover.warn { fill: hsl(var(--destructive)); }
    .bl-grow-fill { opacity: 0; transition: opacity .9s ease .5s; }
    [data-reveal].is-visible .bl-grow-fill { opacity: 1; }

    @media (prefers-reduced-motion: reduce) {
      .tkw-scan::after, .tkw-chip, .tkw-shine::after, .tkw-live::before { animation: none !important; }
      .bl-pulsering, .bl-floaty, .bl-blink, .bl-dissolve, .bl-rise, .bl-glow, .bl-shine, .bl-mover { animation: none !important; }
      .bl-mover, .bl-glow { opacity: 0 !important; }
      .bl-grow-fill { opacity: 1 !important; transition: none !important; }
      .tkw-chip { transform: none !important; }
      [data-reveal].is-visible .tkw-gauge { transition: none; --tkwv: var(--to,0); }
      [data-reveal].is-visible .tkw-bar > i { animation: none; width: var(--bw,100%); }
      .tkw-arc, .tkw-draw { stroke-dashoffset: 0 !important; animation: none !important; }
      .tkw-pop { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>

<main id="top">

    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-6 pb-16 lg:pt-8 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="hero-grid-bg" aria-hidden="true"></div>
