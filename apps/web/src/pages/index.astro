---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="HevaSEO - Entity Backlinks, SEO Content & Indexer"
  description="HevaSEO delivers entity backlinks, SEO content writing, and a backlink indexer that help your website rank on Google sustainably."
  keywords="entity backlinks, SEO content writing, backlink indexer, SEO services, GEO, SEO entity, website audit"
  ogTitle="HevaSEO - Entity Backlinks, SEO Content & Indexer"
  ogDescription="HevaSEO combines entity backlinks, SEO/GEO content, and an indexer to help your website rank on Google sustainably and earn AI trust."
  ogImageAlt="HevaSEO - Sustainable SEO for brands"
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://hevaseo.com/#organization",
        "name": "HevaSEO",
        "url": "https://hevaseo.com/",
        "logo": "https://hevaseo.com/logo/hevaseo-mark-blue.svg",
        "description": "HevaSEO delivers entity backlinks, SEO/GEO content, and a backlink indexer that help your website rank on Google sustainably and earn AI trust.",
        "email": "hello@hevaseo.com",
        "telephone": "+1 (415) 555-0142",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "San Francisco",
          "addressCountry": "US"
        },
        "sameAs": [
          "https://www.facebook.com/hevaseo",
          "https://www.youtube.com/@hevaseo",
          "https://www.linkedin.com/company/hevaseo"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://hevaseo.com/#website",
        "url": "https://hevaseo.com/",
        "name": "HevaSEO",
        "inLanguage": "en",
        "publisher": { "@id": "https://hevaseo.com/#organization" }
      },
      {
        "@type": "Service",
        "name": "Entity Backlinks",
        "serviceType": "Entity backlinks & citations",
        "provider": { "@id": "https://hevaseo.com/#organization" },
        "areaServed": "US",
        "description": "A white-hat backlink network and consistent entity profiles across authoritative platforms that pass ranking power to your website."
      },
      {
        "@type": "Service",
        "name": "SEO & GEO Content Writing",
        "serviceType": "Content SEO/GEO",
        "provider": { "@id": "https://hevaseo.com/#organization" },
        "areaServed": "US",
        "description": "Expert articles built around search intent, E-E-A-T compliant, with schema and internal links so Google ranks them and AI cites them."
      },
      {
        "@type": "Service",
        "name": "Backlink Indexer",
        "serviceType": "Index pipeline",
        "provider": { "@id": "https://hevaseo.com/#organization" },
        "areaServed": "US",
        "description": "An automated pipeline that submits, checks, and retries indexing so every backlink is genuinely recognized by Google."
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Are entity backlinks safe with Google's algorithm?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build entities the white-hat way: consistent brand profiles on authoritative platforms, citations and natural contextual links, no spam, fully compliant with Google's policies." }
          },
          {
            "@type": "Question",
            "name": "How long until I see ranking results?",
            "acceptedAnswer": { "@type": "Answer", "text": "You'll typically see meaningful movement within 6-12 weeks, depending on keyword competition and the current state of your website. We report progress regularly so you can follow along." }
          },
          {
            "@type": "Question",
            "name": "Can I buy just a single service?",
            "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. You can purchase entity, content, or indexer on their own. Combining all three usually works better and comes with bundle pricing." }
          },
          {
            "@type": "Question",
            "name": "How do you report and measure results?",
            "acceptedAnswer": { "@type": "Answer", "text": "Every project has a real-time dashboard tracking rankings, traffic, and backlink status, along with regular email reports and review calls with your dedicated specialist." }
          },
          {
            "@type": "Question",
            "name": "Are the prices on this page fixed?",
            "acceptedAnswer": { "@type": "Answer", "text": "These are reference figures to help you plan a budget. The final quote depends on your industry, competition, and scope of work. Contact us for an accurate quote." }
          }
        ]
      }
    ]
  }
  </script>

  <!-- decorative aurora glow -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-brand-400/15 blur-[120px] dark:bg-brand-500/10"></div>
    <div class="absolute top-[30rem] -right-40 h-[34rem] w-[34rem] rounded-full bg-teal-300/15 blur-[120px] dark:bg-teal-500/10"></div>
  </div>

<main id="top">
    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden px-5 pb-12 pt-6 lg:px-8 lg:pb-14 lg:pt-6">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-[1.02fr_0.98fr]">
        <div class="relative z-10 text-left">
          <div data-reveal class="mb-6 flex flex-wrap items-center gap-3 text-sm font-medium text-muted-foreground">
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 shadow-sm">
              <img src="https://cdn.simpleicons.org/google" alt="" class="h-4 w-4" /> 4.9 Google
            </span>
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 shadow-sm">
              <i class="ph-fill ph-star text-amber-500"></i> 200+ SEO projects
            </span>
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 shadow-sm">
              <i class="ph-bold ph-shield-check text-primary"></i> White-hat, transparent
            </span>
          </div>

          <h1 data-reveal class="max-w-4xl text-balance text-3xl font-semibold leading-[1.15] tracking-tight text-foreground md:text-4xl">
            Sustainable SEO for brands that want to be <span class="text-shimmer text-primary">trusted by Google and AI</span>
          </h1>

          <p data-reveal class="mt-5 max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground md:text-lg">
            HevaSEO combines entity backlinks, SEO/GEO content, and an indexer so your website earns trust signals, content worth citing, and clearly measurable progress.
          </p>

          <div data-reveal class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#contact" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-sm font-bold text-primary-foreground shadow-lg shadow-brand-500/25 transition hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-xl active:scale-[0.98]">
              Free Consultation <i class="ph-bold ph-arrow-right"></i>
            </a>
            <a href="#pricing" class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-card px-6 py-3.5 text-sm font-bold text-foreground shadow-sm transition hover:-translate-y-0.5 hover:bg-accent hover:text-accent-foreground active:scale-[0.98]">
              View service plans
            </a>
          </div>

          <div data-reveal class="mt-8 max-w-2xl">
            <div class="group relative overflow-hidden rounded-2xl border border-primary/30 bg-gradient-to-br from-primary/12 via-card to-card shadow-lg shadow-primary/10">
              <div aria-hidden="true" class="absolute -right-10 -top-12 h-40 w-40 rounded-full bg-primary/15 blur-3xl transition group-hover:bg-primary/25"></div>
              <!-- countdown strip -->
              <div class="relative flex flex-wrap items-center justify-between gap-2 border-b border-primary/20 bg-primary/10 px-5 py-2.5">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-primary">
                  <i class="ph-fill ph-fire"></i> Offer ends in
                </span>
                <span class="flex items-center gap-1.5 font-display text-sm font-bold tabular-nums text-primary">
                  <b class="js-cd-d rounded bg-primary px-1.5 py-0.5 text-primary-foreground">00</b><span class="text-[10px] font-semibold uppercase text-primary/75">days</span>
                  <b class="js-cd-h rounded bg-primary px-1.5 py-0.5 text-primary-foreground">00</b><span class="text-[10px] font-semibold uppercase text-primary/75">hrs</span>
                  <b class="js-cd-m rounded bg-primary px-1.5 py-0.5 text-primary-foreground">00</b><span class="text-[10px] font-semibold uppercase text-primary/75">min</span>
                  <b class="js-cd-s rounded bg-primary px-1.5 py-0.5 text-primary-foreground">00</b><span class="text-[10px] font-semibold uppercase text-primary/75">sec</span>
                </span>
              </div>
              <div class="relative flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
                <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-primary text-primary-foreground shadow-md shadow-primary/30">
                  <i class="ph-fill ph-gift text-3xl"></i>
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-base font-semibold leading-snug text-foreground">
                    Free — <span class="text-primary">Keyword Research &amp; SEO Strategy</span>
                  </p>
                  <p class="mt-0.5 text-sm text-muted-foreground">
                    With any Content or Backlink plan ·
                    <span class="text-muted-foreground/70 line-through">$159</span>
                    <span class="font-bold text-primary">Free</span>
                  </p>
                </div>
                <a href="#offers" id="promo-toggle" aria-expanded="false" aria-controls="offers" class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground shadow-md shadow-primary/25 transition hover:-translate-y-0.5 hover:bg-primary/90 active:scale-[0.98]">
                  <span class="promo-toggle-label">View all offers</span> <i class="ph-bold ph-caret-down promo-toggle-caret transition"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div data-reveal class="hero-mock-scale relative z-10">
          <div aria-hidden="true" class="absolute -inset-6 rounded-[2rem] bg-brand-500/15 blur-3xl"></div>

          <!-- notification toasts that slide in/out in turn (desktop) -->
          <div class="hero-toasts" aria-hidden="true">
            <div class="hero-toast" style="--toast-delay:0s">
              <span class="hero-toast-icon bg-emerald-500/15 text-emerald-600"><i class="ph-fill ph-check-circle"></i></span>
              <div><b>12 backlinks just got indexed</b><em>guest-post · 30 seconds ago</em></div>
            </div>
            <div class="hero-toast" style="--toast-delay:4s">
              <span class="hero-toast-icon bg-primary/15 text-primary"><i class="ph-fill ph-trend-up"></i></span>
              <div><b>hevashop.com hits Top 3</b><em>keyword “pediatric dentistry”</em></div>
            </div>
            <div class="hero-toast" style="--toast-delay:8s">
              <span class="hero-toast-icon bg-violet-500/15 text-violet-600"><i class="ph-fill ph-pen-nib"></i></span>
              <div><b>SEO/GEO article published</b><em>with schema + internal links</em></div>
            </div>
          </div>
          <!-- floating ranking chip -->
          <div class="hero-chip-float" aria-hidden="true">
            <i class="ph-fill ph-trophy"></i> 9,400+ keywords in Top 10 <span>· realtime</span>
          </div>

          <!-- WHEEL SLIDER: slides rotate around a virtual axis below, like a wheel -->
          <div class="hero-wheel on-dash" id="hero-wheel">
            <!-- SLIDE 1: realtime dashboard (in-flow, sets the slider height) -->
            <div class="wheel-slide is-base whl-in" data-wheel-slide>
          <div class="glass-dashboard hero-dashboard relative">
            <div class="flex">
              <!-- mini sidebar rail -->
              <aside class="hidden w-14 shrink-0 flex-col items-center gap-1 border-r border-border/60 bg-white/40 py-3 dark:bg-white/5 sm:flex">
                <span class="grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-lg shadow-brand-500/25"><svg viewBox="0 0 240 240" class="h-[88%] w-[88%]" fill="currentColor" aria-hidden="true"><path d="M33.4 171.9L32.5 175.4L33.6 178.9L36.2 181.4L67.8 198.6L71.3 199.4L74.8 198.4L77.3 195.8L105 145.2L134.2 145L135.6 145.8L162.7 195.8L165.2 198.4L168.7 199.4L172.2 198.6L203.8 181.4L206.4 178.9L207.5 175.4L206.6 171.9L178.7 120L206.6 68.1L207.5 64.6L206.4 61.1L203.8 58.6L172.2 41.4L168.7 40.6L165.2 41.6L162.7 44.2L135 94.8L105.8 95L104.4 94.2L77.3 44.2L74.8 41.6L71.3 40.6L67.8 41.4L36.2 58.6L33.6 61.1L32.5 64.6L33.4 68.1L61.3 120Z"/></svg></span>
                <div class="mt-3 flex flex-col items-center gap-1.5">
                  <span class="hero-rail active"><i class="ph-bold ph-squares-four"></i></span>
                  <span class="hero-rail"><i class="ph-bold ph-globe-hemisphere-west"></i></span>
                  <span class="hero-rail"><i class="ph-bold ph-kanban"></i></span>
                  <span class="hero-rail"><i class="ph-bold ph-chart-line-up"></i></span>
                  <span class="hero-rail"><i class="ph-bold ph-gear-six"></i></span>
                </div>
              </aside>

              <!-- main -->
              <div class="min-w-0 flex-1">
                <div class="dashboard-topbar">
                  <div>
                    <div class="flex items-center gap-2">
                      <p class="font-display text-base font-semibold tracking-tight">Overview</p>
                      <span class="hero-live"><span></span> Live</span>
                    </div>
                    <p class="text-[11px] text-muted-foreground">4 active projects · updated 2 minutes ago</p>
                  </div>
                  <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-xs font-bold text-white shadow-md">HV</span>
                </div>

                <div class="space-y-2.5 p-4">
                  <!-- KPI grid -->
                  <div class="grid grid-cols-2 gap-2.5">
                    <!-- VIP -->
                    <div class="hero-kpi">
                      <div class="flex items-center justify-between">
                        <span class="grid h-8 w-8 place-items-center rounded-lg bg-amber-400/20 text-amber-500"><i class="ph-fill ph-crown"></i></span>
                        <span class="hero-tag-amber">VIP</span>
                      </div>
                      <p class="hero-kpi-label">Membership tier</p>
                      <div class="flex items-end justify-between gap-2">
                        <p class="hero-kpi-value font-display">VIP</p>
                        <div class="hero-tier"><i class="on" style="height:40%"></i><i class="on" style="height:60%"></i><i class="on" style="height:80%"></i><i class="on" style="height:95%"></i><i style="height:100%"></i></div>
                      </div>
                    </div>
                    <!-- ring -->
                    <div class="hero-kpi">
                      <div class="flex items-center justify-between">
                        <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary/15 text-primary"><i class="ph-bold ph-timer"></i></span>
                        <span class="hero-good">On time</span>
                      </div>
                      <p class="hero-kpi-label">Completed on time</p>
                      <div class="flex items-end justify-between gap-2">
                        <p class="hero-kpi-value font-display">96%</p>
                        <div class="hero-ring" style="--p:96"><b>96%</b></div>
                      </div>
                    </div>
                  </div>

                  <!-- services card with segmented bar -->
                  <div class="rounded-2xl border border-border bg-card p-4">
                    <div class="flex items-center justify-between gap-3">
                      <div class="flex items-center gap-2.5">
                        <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary/15 text-primary"><i class="ph-bold ph-package"></i></span>
                        <div>
                          <p class="hero-kpi-label">Services ordered</p>
                          <p class="font-display text-lg font-semibold leading-none">32 <span class="text-xs font-normal text-muted-foreground">services</span></p>
                        </div>
                      </div>
                      <span class="hero-good">All</span>
                    </div>
                    <div class="hero-seg mt-3"><i style="width:32%;background:#3b82f6"></i><i style="width:30%;background:#10b981"></i><i style="width:24%;background:#f59e0b"></i><i style="width:14%;background:#a78bfa"></i></div>
                    <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-muted-foreground">
                      <span class="inline-flex items-center gap-1"><span class="hero-dot" style="background:#3b82f6"></span>Backlink</span>
                      <span class="inline-flex items-center gap-1"><span class="hero-dot" style="background:#10b981"></span>Content</span>
                      <span class="inline-flex items-center gap-1"><span class="hero-dot" style="background:#f59e0b"></span>Index</span>
                    </div>
                  </div>

                  <!-- mini kanban summary -->
                  <div class="rounded-2xl border border-border bg-card p-4">
                    <div class="mb-2.5 flex items-center justify-between">
                      <p class="text-sm font-semibold">Reports · Kanban</p>
                      <span class="text-[11px] font-semibold text-primary">View all</span>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-center">
                      <div class="rounded-lg bg-muted/60 py-2 dark:bg-white/5"><span class="hero-kdot" style="background:#94a3b8"></span><p class="font-display text-sm font-semibold">4</p><p class="text-[10px] text-muted-foreground">Planned</p></div>
                      <div class="rounded-lg bg-muted/60 py-2 dark:bg-white/5"><span class="hero-kdot" style="background:hsl(var(--primary))"></span><p class="font-display text-sm font-semibold">5</p><p class="text-[10px] text-muted-foreground">Progress</p></div>
                      <div class="rounded-lg bg-muted/60 py-2 dark:bg-white/5"><span class="hero-kdot" style="background:#f59e0b"></span><p class="font-display text-sm font-semibold">2</p><p class="text-[10px] text-muted-foreground">Review</p></div>
                      <div class="rounded-lg bg-muted/60 py-2 dark:bg-white/5"><span class="hero-kdot" style="background:#10b981"></span><p class="font-display text-sm font-semibold">5</p><p class="text-[10px] text-muted-foreground">Done</p></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
            </div>

            <!-- SLIDE 2: USP Backlink Entity -->
            <div class="wheel-slide whl-wait" data-wheel-slide>
              <div class="wheel-card">
                <div class="flex items-center justify-between">
                  <span class="wheel-eyebrow"><i class="ph-fill ph-share-network"></i> Backlink Entity</span>
                  <span class="hero-live"><span></span> White-hat</span>
                </div>
                <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">Entities where <span class="text-primary">Google cross-checks</span></h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Brand profiles with matching NAP across business directories, social networks, Wikidata, and the press — enough proof for Google to trust that you’re real.</p>
                <div class="bp-graph mt-4">
                  <svg viewBox="0 0 260 92" preserveAspectRatio="xMidYMid meet">
                    <path id="hwg-p1" class="bpg-path" d="M34,18 Q82,18 118,42" />
                    <path id="hwg-p2" class="bpg-path" d="M34,74 Q82,74 118,50" />
                    <path id="hwg-p3" class="bpg-path" d="M226,18 Q178,18 142,42" />
                    <path id="hwg-p4" class="bpg-path" d="M226,74 Q178,74 142,50" />
                    <circle class="bpg-dot" r="2.6"><animateMotion dur="2.2s" repeatCount="indefinite"><mpath href="#hwg-p1"/></animateMotion></circle>
                    <circle class="bpg-dot" r="2.6"><animateMotion dur="2.6s" begin="0.7s" repeatCount="indefinite"><mpath href="#hwg-p2"/></animateMotion></circle>
                    <circle class="bpg-dot" r="2.6"><animateMotion dur="2.4s" begin="1.2s" repeatCount="indefinite"><mpath href="#hwg-p3"/></animateMotion></circle>
                    <circle class="bpg-dot" r="2.6"><animateMotion dur="2.8s" begin="0.3s" repeatCount="indefinite"><mpath href="#hwg-p4"/></animateMotion></circle>
                    <g class="bpg-node"><circle cx="34" cy="18" r="11"/><text x="34" y="18">E</text></g>
                    <g class="bpg-node"><circle cx="34" cy="74" r="11"/><text x="34" y="74">P</text></g>
                    <g class="bpg-node"><circle cx="226" cy="18" r="11"/><text x="226" y="18">G</text></g>
                    <g class="bpg-node"><circle cx="226" cy="74" r="11"/><text x="226" y="74">PR</text></g>
                    <circle class="bpg-center-pulse" cx="130" cy="46" r="15"/>
                    <g class="bpg-center"><circle cx="130" cy="46" r="15"/><text x="130" y="46">WEB</text></g>
                  </svg>
                </div>
                <div class="mt-auto grid grid-cols-3 gap-2.5 pt-4">
                  <div class="rounded-xl border border-border bg-card p-3 text-center"><p class="font-display text-xl font-bold text-primary">80+</p><p class="mt-0.5 text-[11px] font-medium text-muted-foreground">Authoritative platforms</p></div>
                  <div class="rounded-xl border border-border bg-card p-3 text-center"><p class="font-display text-xl font-bold text-primary">100%</p><p class="mt-0.5 text-[11px] font-medium text-muted-foreground">Consistent NAP</p></div>
                  <div class="rounded-xl border border-border bg-card p-3 text-center"><p class="font-display text-xl font-bold text-primary">4 systems</p><p class="mt-0.5 text-[11px] font-medium text-muted-foreground">Entity · Pyramid · Guest · Press</p></div>
                </div>
              </div>
            </div>

            <!-- SLIDE 3: USP Content GEO / AI -->
            <div class="wheel-slide whl-wait" data-wheel-slide>
              <div class="wheel-card">
                <div class="flex items-center justify-between">
                  <span class="wheel-eyebrow"><i class="ph-fill ph-sparkle"></i> Content SEO/GEO</span>
                  <span class="hero-live"><span></span> AI-ready</span>
                </div>
                <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">AI <span class="text-primary">cites</span> your brand</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">E-E-A-T-grade articles that answer search intent so ChatGPT, Gemini, and Perplexity mention you in their answers.</p>
                <div class="my-auto space-y-2.5 py-4">
                  <div class="ml-auto max-w-[85%] rounded-xl rounded-tr-sm bg-secondary px-3.5 py-2.5 text-[13px] font-medium">Reliable entity SEO services for a new website?</div>
                  <div class="max-w-[92%] rounded-xl rounded-tl-sm border-2 border-primary bg-primary/10 px-3.5 py-2.5">
                    <p class="text-[13px] font-bold text-primary">1. HevaSEO</p>
                    <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">Consistent entity profiles, expert content, and backlinks recognized by Google.</p>
                  </div>
                </div>
                <div class="mt-auto flex flex-wrap gap-2 pt-4">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1.5 text-xs font-semibold"><img src="https://cdn.simpleicons.org/openai" alt="" class="h-3.5 w-3.5" /> ChatGPT</span>
