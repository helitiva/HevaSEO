---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title={`${post.data.title} — HevaSEO`}
  description={post.data.description}
  contactHref="/#contact"
>
  <main class="mx-auto max-w-3xl px-5 py-14 lg:px-8 lg:py-20">
    <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition hover:text-primary"><i class="ph-bold ph-arrow-left"></i> All posts</a>
    <div class="mt-6 flex flex-wrap gap-2">
      {post.data.tags.map((t) => (
        <span class="rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-semibold text-accent-foreground">{t}</span>
      ))}
    </div>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{post.data.title}</h1>
    <p class="mt-3 text-sm text-muted-foreground">{post.data.author} · {fmt(post.data.pubDate)}</p>
    <article class="heva-prose mt-10">
      <Content />
    </article>
  </main>
</BaseLayout>

<style is:global>
  .heva-prose { color: hsl(var(--muted-foreground)); line-height: 1.75; font-size: 0.95rem; }
  .heva-prose > * + * { margin-top: 1.1rem; }
  .heva-prose h2 { color: hsl(var(--foreground)); font-weight: 600; font-size: 1.35rem; margin-top: 2rem; letter-spacing: -0.01em; }
  .heva-prose strong { color: hsl(var(--foreground)); font-weight: 600; }
  .heva-prose a { color: hsl(var(--primary)); font-weight: 500; text-decoration: underline; }
  .heva-prose ul { list-style: disc; padding-left: 1.25rem; }
  .heva-prose li + li { margin-top: 0.35rem; }
  .heva-prose blockquote { border-left: 3px solid hsl(var(--primary)); padding-left: 1rem; color: hsl(var(--foreground)); font-style: italic; }
  .heva-prose code { background: hsl(var(--muted)); padding: 0.1rem 0.35rem; border-radius: 0.3rem; font-size: 0.85em; }
</style>
