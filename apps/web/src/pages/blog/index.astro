---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="Blog — HevaSEO"
  description="Guides on entity SEO, GEO, content, and backlinks from the HevaSEO team."
  contactHref="/#contact"
>
  <main class="mx-auto max-w-5xl px-5 py-14 lg:px-8 lg:py-20">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Blog</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">SEO &amp; GEO insights</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">Practical guides on entity SEO, content, indexing, and showing up in AI answers.</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="group flex flex-col rounded-2xl border border-border bg-card p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((t) => (
              <span class="rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-semibold text-accent-foreground">{t}</span>
            ))}
          </div>
          <h2 class="mt-3 text-lg font-semibold tracking-tight text-foreground group-hover:text-primary">{post.data.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
          <p class="mt-4 text-xs text-muted-foreground">{post.data.author} · {fmt(post.data.pubDate)}</p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
