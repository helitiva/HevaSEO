---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="SEO Website Audit | HevaSEO — SEO Health Score across 200+ criteria"
  description="HevaSEO Website Audit service: an SEO health score across 200+ technical, on-page, content, backlink, and Core Web Vitals criteria. A detailed report with a fix roadmap. From $14."
  keywords="audit website, seo audit, website seo check, seo health score, core web vitals, technical seo, website audit service"
  ogDescription="An SEO health score across 200+ criteria, with a detailed report and a prioritized fix roadmap. Plans from $14."
  ogImageAlt="HevaSEO - SEO Website Audit"
>
  <script type="application/ld+json" slot="head" is:inline>
{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "SEO Website Audit",
        "serviceType": "SEO audit",
        "provider": {
          "@type": "Organization",
          "name": "HevaSEO",
          "url": "https://hevaseo.com/"
        },
        "areaServed": "US",
        "description": "A comprehensive SEO health score across 200+ technical, on-page, content, backlink, and Core Web Vitals criteria, with a detailed report and a prioritized fix roadmap.",
        "offers": [
          { "@type": "Offer", "name": "Basic plan", "price": "14", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Advanced plan", "price": "26", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Comprehensive plan", "price": "60", "priceCurrency": "USD" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hevaseo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Website Audit", "item": "https://hevaseo.com/audit" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a website audit and why do you need one?",
            "acceptedAnswer": { "@type": "Answer", "text": "A website audit is a comprehensive check of your site's SEO health: technical, on-page, content, backlinks, and user experience. It tells you exactly which issues are dragging your rankings down and what to prioritize first, so you don't spend SEO budget on a broken foundation." }
          },
          {
            "@type": "Question",
            "name": "How long until I receive the audit report?",
            "acceptedAnswer": { "@type": "Answer", "text": "The Basic plan delivers in 1-2 business days, Advanced in 3-5 days, and Comprehensive in 5-7 days, depending on your site's size." }
          },
          {
            "@type": "Question",
            "name": "After the audit, do I get fix guidance?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every plan includes a list of issues sorted by priority. The Advanced and Comprehensive plans also include a detailed fix roadmap and a live consultation so you or your technical team can execute." }
          },
          {
            "@type": "Question",
            "name": "Which audit plan should I choose?",
            "acceptedAnswer": { "@type": "Answer", "text": "Choose Basic if you need a quick snapshot of your website's health. Choose Advanced for a deep manual audit with competitor comparison and a roadmap. Choose Comprehensive if you're about to run a major SEO campaign and need backlink analysis, content-gap analysis, and a 90-day plan." }
          }
        ]
      }
    ]
  }
  </script>
  <style slot="head" is:global is:inline>
/* shared hero background (synced across service pages) */
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 54px 54px;
      -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 30%, transparent 78%);
      opacity: 0.45;
    }
    .hero-blob {
      position: absolute; border-radius: 9999px; filter: blur(72px);
      pointer-events: none; z-index: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.20), transparent 70%);
    }

    /* decorative dotted grid backdrop */
    .au-grid {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--border) / 0.7) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border) / 0.7) 1px, transparent 1px);
      background-size: 46px 46px;
      -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, #000 25%, transparent 78%);
      mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, #000 25%, transparent 78%);
      opacity: 0.55;
    }
    /* floating gradient blobs */
    .au-blob { position: absolute; z-index: 0; border-radius: 9999px; filter: blur(72px); pointer-events: none; }
    .au-blob-a { background: radial-gradient(circle, hsl(214 95% 58% / 0.45), transparent 70%); animation: auFloatA 15s ease-in-out infinite; }
    .au-blob-b { background: radial-gradient(circle, hsl(190 92% 60% / 0.38), transparent 70%); animation: auFloatB 19s ease-in-out infinite; }
    @keyframes auFloatA { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(34px,-26px) scale(1.14); } }
    @keyframes auFloatB { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-28px,22px) scale(1.1); } }

    /* shimmering gradient heading */
    .au-shine {
      background: linear-gradient(100deg, hsl(var(--foreground)) 18%, hsl(var(--primary)) 50%, hsl(var(--foreground)) 82%);
      background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: auShine 6.5s linear infinite;
    }
    @keyframes auShine { to { background-position: 200% center; } }

    /* card: hover lift + animated gradient border ring */
    .au-card { position: relative; transition: transform .4s cubic-bezier(.16,1,.3,1), box-shadow .4s, border-color .4s; }
    .au-card:hover { transform: translateY(-6px); border-color: hsl(var(--primary) / 0.5);
      box-shadow: 0 20px 44px -14px hsl(214 90% 42% / 0.32), inset 0 1px 0 hsl(0 0% 100% / 0.04); }
    .au-card::after { /* gradient border ring on hover (1px edge only, never covers content) */
      content: ""; position: absolute; inset: 0; z-index: 4; border-radius: inherit; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, hsl(var(--primary) / 0.75), transparent 42%, transparent 58%, hsl(190 92% 60% / 0.65));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      opacity: 0; transition: opacity .4s;
    }
    .au-card:hover::after { opacity: 1; }

    /* icon tile reacts to card hover */
    .au-ico { transition: transform .4s cubic-bezier(.16,1,.3,1), background-color .4s, color .4s; }
    .au-card:hover .au-ico { transform: translateY(-3px) rotate(-4deg) scale(1.08); background: hsl(var(--primary)); color: #fff; }

    /* stat count-up pop */
    .au-stat { transition-delay: var(--d, 0s); }

    /* process connector + pulsing nodes */
    .au-steps-line { position: absolute; left: 0; right: 0; top: 86px; height: 2px; z-index: 0;
      background: linear-gradient(90deg, transparent, hsl(var(--primary) / 0.55), hsl(190 92% 60% / 0.55), transparent);
      transform: scaleX(0); transform-origin: left; }
    [data-reveal].is-visible .au-steps-line { animation: auLineGrow 1.2s .15s cubic-bezier(.16,1,.3,1) forwards; }
    @keyframes auLineGrow { to { transform: scaleX(1); } }
    .au-node { position: relative; }
    .au-node::after { content: ""; position: absolute; inset: -4px; border-radius: 9999px; box-shadow: 0 0 0 0 hsl(var(--primary) / 0.45); animation: auNodePulse 2.6s ease-out infinite; animation-delay: var(--d, 0s); }
    @keyframes auNodePulse { 0% { box-shadow: 0 0 0 0 hsl(var(--primary) / 0.45); } 70%,100% { box-shadow: 0 0 0 16px hsl(var(--primary) / 0); } }

    /* popular pricing card: animated sheen overlay (clips itself, keeps badge visible) */
    .au-sheen { position: absolute; inset: 0; z-index: 3; border-radius: inherit; overflow: hidden; pointer-events: none; }
    .au-sheen::before { content: ""; position: absolute; top: -10%; bottom: -10%; left: -70%; width: 45%;
      background: linear-gradient(100deg, transparent, hsl(0 0% 100% / 0.22), transparent); transform: skewX(-18deg);
      animation: auSheen 6s ease-in-out infinite; }
    @keyframes auSheen { 0%,55% { left: -70%; } 80%,100% { left: 140%; } }

    /* marquee ticker */
    .au-marquee { overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    .au-marquee-track { display: flex; align-items: center; gap: 1rem; width: max-content; animation: auMarquee 32s linear infinite; }
    .au-marquee:hover .au-marquee-track { animation-play-state: paused; }
    @keyframes auMarquee { to { transform: translateX(-50%); } }

    /* report sample bars grow when revealed */
    .au-bar > i { display: block; height: 100%; border-radius: 9999px; transform: scaleX(0); transform-origin: left;
      background: hsl(var(--primary)); }
    [data-reveal].is-visible .au-bar > i { animation: auBarGrow 1.1s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--d, 0s); }
    @keyframes auBarGrow { to { transform: scaleX(1); } }

    /* soft entrance for any element using inline --d as transition-delay */
    [data-reveal][style*="--d"] { transition-delay: var(--d); }

    /* per-grid staggered entrance for cards */
    .au-card:nth-child(1) { transition-delay: .03s; }
    .au-card:nth-child(2) { transition-delay: .10s; }
    .au-card:nth-child(3) { transition-delay: .17s; }
    .au-card:nth-child(4) { transition-delay: .24s; }
    .au-card:nth-child(5) { transition-delay: .31s; }
    .au-card:nth-child(6) { transition-delay: .38s; }

    /* cursor spotlight on cards (faint, harmless above content) */
    .au-card::before {
      content: ""; position: absolute; inset: 0; z-index: 3; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .45s;
      background: radial-gradient(240px circle at var(--mx,50%) var(--my,50%), hsl(var(--primary) / 0.14), transparent 60%);
    }
    .au-card:hover::before { opacity: 1; }

    /* 3D tilt (driven by JS), smooth return on leave */
    [data-tilt] { transform-style: preserve-3d; transition: transform .5s cubic-bezier(.16,1,.3,1), box-shadow .4s, border-color .4s; }
    [data-tilt].au-tilting { transition: box-shadow .4s, border-color .4s; }

    /* ===== in-card mini dashboards ===== */
    .au-mini { position: relative; margin-top: 1.25rem; border-radius: .9rem; border: 1px solid hsl(var(--border)); background: hsl(var(--background) / .6); padding: .85rem .9rem; overflow: hidden; }
    .dark .au-mini { background: hsl(222 47% 11% / .55); }
    .au-mini-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .65rem; font-size: .7rem; color: hsl(var(--muted-foreground)); }
    .au-mini-live { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; }
    .au-mini-live::before { content: ""; width: 6px; height: 6px; border-radius: 9999px; background: hsl(var(--primary)); box-shadow: 0 0 0 0 hsl(var(--primary) / .5); animation: auMiniPing 2s ease-out infinite; }
    @keyframes auMiniPing { 0% { box-shadow: 0 0 0 0 hsl(var(--primary) / .5); } 70%,100% { box-shadow: 0 0 0 7px hsl(var(--primary) / 0); } }
    .au-mini-tag { padding: .1rem .45rem; border-radius: 9999px; background: hsl(var(--primary) / .1); color: hsl(var(--primary)); font-weight: 700; border: 1px solid hsl(var(--primary) / .18); white-space: nowrap; }
    /* bar rows */
    .au-row { display: flex; align-items: center; gap: .5rem; margin-top: .5rem; font-size: .72rem; }
    .au-row .k { width: 42px; flex: none; color: hsl(var(--muted-foreground)); }
    .au-trk { position: relative; flex: 1; height: 6px; border-radius: 9999px; background: hsl(var(--border)); overflow: hidden; }
    .au-trk > i { display: block; height: 100%; border-radius: inherit; transform: scaleX(0); transform-origin: left; background: linear-gradient(90deg, hsl(var(--primary)), hsl(190 92% 55%)); }
    [data-reveal].is-visible .au-trk > i { animation: auBarGrow 1s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--d,0s); }
    .au-row .v { min-width: 34px; text-align: right; font-weight: 700; color: hsl(var(--foreground)); }
    .au-good { color: hsl(150 55% 38%); } .dark .au-good { color: hsl(150 70% 62%); }
    /* log rows */
    .au-log { display: flex; align-items: center; gap: .45rem; margin-top: .45rem; font-size: .72rem; color: hsl(var(--foreground)); opacity: 0; transform: translateX(-6px); }
    [data-reveal].is-visible .au-log { animation: auFadeX .5s ease forwards; animation-delay: var(--d,0s); }
    @keyframes auFadeX { to { opacity: 1; transform: none; } }
    .au-log .mono { color: hsl(var(--muted-foreground)); font-variant-numeric: tabular-nums; }
    .au-log .st { margin-left: auto; font-size: .62rem; font-weight: 700; padding: .08rem .42rem; border-radius: 9999px; white-space: nowrap; }
    .au-st-ok { background: hsl(150 60% 45% / .14); color: hsl(150 55% 36%); } .dark .au-st-ok { color: hsl(150 70% 65%); }
    .au-st-warn { background: hsl(38 90% 50% / .15); color: hsl(28 85% 40%); } .dark .au-st-warn { color: hsl(38 95% 68%); }
    /* chips */
    .au-chips { display: flex; flex-wrap: wrap; gap: .35rem; }
    .au-chips.mt { margin-top: .6rem; }
    .au-chip { display: inline-flex; align-items: center; gap: .25rem; font-size: .66rem; font-weight: 600; padding: .2rem .5rem; border-radius: 9999px;
      background: hsl(var(--primary) / .09); color: hsl(var(--primary)); border: 1px solid hsl(var(--primary) / .18); opacity: 0; transform: translateY(5px); }
    [data-reveal].is-visible .au-chip, [data-reveal].is-visible .au-ai-cite { animation: auFadeUp .5s ease forwards; animation-delay: var(--d,0s); }
    @keyframes auFadeUp { to { opacity: 1; transform: none; } }
    /* article lines */
    .au-lines { display: grid; gap: .4rem; }
    .au-ln { position: relative; overflow: hidden; height: 7px; border-radius: 9999px; background: hsl(var(--border)); transform: scaleX(0); transform-origin: left; }
    [data-reveal].is-visible .au-ln { animation: auBarGrow .8s cubic-bezier(.16,1,.3,1) forwards; animation-delay: var(--d,0s); }
    .au-ln.h { background: hsl(var(--primary) / .42); height: 9px; }
    /* AI bubble */
    .au-ai { display: flex; gap: .5rem; }
    .au-ai-ava { flex: none; width: 22px; height: 22px; border-radius: 7px; display: grid; place-items: center; color: #fff; font-size: .72rem; background: linear-gradient(135deg, hsl(var(--primary)), hsl(226 90% 56%)); animation: auAvaPulse 3.2s ease-in-out infinite; }
    .au-ai-body { flex: 1; min-width: 0; }
    .au-ai-cite { display: inline-flex; align-items: center; gap: .3rem; margin-top: .45rem; font-size: .66rem; font-weight: 700; padding: .15rem .5rem; border-radius: 9999px; background: hsl(var(--primary) / .1); color: hsl(var(--primary)); border: 1px solid hsl(var(--primary) / .2); opacity: 0; transform: translateY(5px); }

    /* ----- gentle idle motion inside minis ----- */
    .au-trk > i { position: relative; }
    .au-trk > i::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: hsl(0 0% 100% / .28); opacity: 0; }
    [data-reveal].is-visible .au-trk > i::after { animation: auGlowBreath 3.4s ease-in-out infinite; animation-delay: calc(var(--d,0s) + 1s); }
    .au-ln::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: hsl(var(--primary) / .3); opacity: 0; }
    [data-reveal].is-visible .au-ln::after { animation: auGlowBreath 3.8s ease-in-out infinite; animation-delay: calc(var(--d,0s) + 1.1s); }
    @keyframes auGlowBreath { 0%,100% { opacity: 0; } 50% { opacity: .5; } }
    @keyframes auAvaPulse { 0%,100% { box-shadow: 0 0 0 0 hsl(var(--primary) / .4); } 60%,100% { box-shadow: 0 0 0 6px hsl(var(--primary) / 0); } }
    .au-mini-tag { animation: auTagBreath 3.6s ease-in-out infinite; }
    @keyframes auTagBreath { 0%,100% { box-shadow: 0 0 0 0 hsl(var(--primary) / 0); } 50% { box-shadow: 0 0 0 3px hsl(var(--primary) / .1); } }
    .au-st-warn { animation: auWarnBreath 2.6s ease-in-out infinite; }
    @keyframes auWarnBreath { 0%,100% { box-shadow: 0 0 0 0 hsl(38 90% 50% / 0); } 50% { box-shadow: 0 0 0 3px hsl(38 90% 50% / .18); } }

    /* report score donut */
    .au-ring-fg { transition: none; }
    [data-reveal].is-visible .au-ring-fg { animation: auRing 1.4s cubic-bezier(.16,1,.3,1) .2s forwards; }
    @keyframes auRing { to { stroke-dashoffset: 12.66; } }

    @media (prefers-reduced-motion: reduce) {
      .au-ring-fg { stroke-dashoffset: 12.66 !important; animation: none !important; }
      [data-tilt] { transform: none !important; }
      .au-blob-a, .au-blob-b, .au-shine, .au-pop::before, .au-marquee-track,
      .au-node::after, .au-steps-line, .au-bar > i { animation: none !important; }
      .au-steps-line, .au-bar > i { transform: none !important; }
      .au-mini-live::before, .au-ai-ava, .au-mini-tag, .au-st-warn { animation: none !important; }
      .au-trk > i, .au-ln { transform: none !important; animation: none !important; }
      .au-trk > i::after, .au-ln::after { animation: none !important; }
      .au-log, .au-chip, .au-ai-cite { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>

<main id="top">
    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden pt-6 pb-16 lg:pt-8 lg:pb-24">
      <canvas id="hero-fx" class="fx-canvas" aria-hidden="true"></canvas>
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-blob" aria-hidden="true" style="top:-6rem;right:-4rem;width:26rem;height:26rem;"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 lg:px-8">
        <!-- breadcrumb -->
        <nav data-reveal class="mb-8 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/#top" class="transition hover:text-primary">Home</a>
          <i class="ph-bold ph-caret-right text-xs"></i>
          <span class="text-foreground">Audit Website</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div data-reveal>
            <h1 class="font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl">
              Know exactly what's <span class="text-primary">dragging your rankings down</span>.
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
              HevaSEO scores your SEO health across <b class="font-semibold text-foreground">200+ criteria</b> — technical, on-page, content, backlinks &amp; Core Web Vitals — then delivers a detailed report with a prioritized fix list. Don't pour SEO budget onto a broken foundation.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#banggia" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:-translate-y-px hover:bg-primary/90 active:scale-[0.98]">
                View plans <i class="ph-bold ph-arrow-down"></i>
              </a>
              <a href="#lienhe" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-6 py-3 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">
                Get a free quick audit
              </a>
            </div>
            <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
              <span class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-base text-emerald-500"></i> Easy-to-read PDF report</span>
              <span class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-base text-emerald-500"></i> Competitor comparison</span>
              <span class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-base text-emerald-500"></i> No binding commitment</span>
            </div>

            <!-- guarantee chips (in-hero, prominent) -->
            <div data-reveal class="mt-6 flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/15 px-3 py-1.5 text-sm font-semibold text-foreground shadow-sm"><i class="ph-fill ph-star text-amber-500"></i> 4.9/5 · 200+ website</span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/15 px-3 py-1.5 text-sm font-semibold text-foreground shadow-sm"><i class="ph-fill ph-shield-check text-primary"></i> 14-day guarantee</span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/15 px-3 py-1.5 text-sm font-semibold text-foreground shadow-sm"><i class="ph-fill ph-headset text-primary"></i> 24/7 support</span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/15 px-3 py-1.5 text-sm font-semibold text-foreground shadow-sm"><i class="ph-fill ph-user-focus text-primary"></i> 1-on-1 consultation</span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/15 px-3 py-1.5 text-sm font-semibold text-foreground shadow-sm"><i class="ph-fill ph-arrow-u-down-left text-primary"></i> Refund if we're late</span>
            </div>
          </div>

          <!-- audit visual -->
          <div data-reveal class="relative">
            <div class="addon-visual audit-visual relative rounded-2xl border border-border bg-card p-6 shadow-xl shadow-primary/5 lg:p-8" aria-hidden="true">
            <div class="audit-head">
              <div class="audit-score-ring">
                <span class="audit-score-num" data-count="87">0</span>
                <span class="audit-score-max">/100</span>
              </div>
              <div class="audit-score-meta">
                <em>SEO Health Score</em>
                <b>Needs improvement</b>
                <span>hevashop.com</span>
              </div>
            </div>
            <div class="audit-trend">
              <span class="audit-trend-label">Last 30 days</span>
              <svg class="audit-trend-spark" viewBox="0 0 120 24" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="auditTrendFill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="hsl(var(--primary))" stop-opacity="0.28"/>
                    <stop offset="100%" stop-color="hsl(var(--primary))" stop-opacity="0"/>
                  </linearGradient>
