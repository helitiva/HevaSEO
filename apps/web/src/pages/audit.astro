  <script is:inline>
(function () {
      function reveal(){ document.documentElement.classList.add('ready'); }
      if (document.readyState === 'complete') { reveal(); return; }
      window.addEventListener('DOMContentLoaded', function(){ requestAnimationFrame(function(){ requestAnimationFrame(reveal); }); });
      window.addEventListener('load', reveal);
      setTimeout(reveal, 1000);
    })();
  </script>

  <script is:inline>
(function () {
    "use strict";
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---- 3D tilt + cursor spotlight ---- */
    if (!reduce && window.matchMedia("(hover: hover)").matches) {
      document.querySelectorAll("[data-tilt]").forEach(function (card) {
        var raf = 0;
        card.addEventListener("pointermove", function (e) {
          var r = card.getBoundingClientRect();
          var px = (e.clientX - r.left) / r.width;
          var py = (e.clientY - r.top) / r.height;
          card.style.setProperty("--mx", (px * 100).toFixed(1) + "%");
          card.style.setProperty("--my", (py * 100).toFixed(1) + "%");
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = 0;
            var rx = (0.5 - py) * 5.5;
            var ry = (px - 0.5) * 5.5;
            card.classList.add("au-tilting");
            card.style.transform = "perspective(900px) rotateX(" + rx.toFixed(2) + "deg) rotateY(" + ry.toFixed(2) + "deg) translateY(-6px)";
          });
        });
        card.addEventListener("pointerleave", function () {
          card.classList.remove("au-tilting");
          card.style.transform = "";
        });
      });
    }

    /* ---- pricing "Choose plan" -> prefill package + smooth scroll to lead form ---- */
    var pkgField = document.getElementById("lead-package");
    var leadInput = document.getElementById("cta-email");
    document.querySelectorAll("a[data-package]").forEach(function (btn) {
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        var pkg = btn.getAttribute("data-package") || "";
        if (pkgField) pkgField.value = pkg;
        var target = document.getElementById("lienhe");
        if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
        if (leadInput) setTimeout(function () { leadInput.focus({ preventScroll: true }); }, 500);
      });
    });

  })();
  </script>

